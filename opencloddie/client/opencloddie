def find_claude_bin(cfg: dict) -> str:
    configured = (cfg.get("claude_bin") or "").strip()
    if configured:
        return configured
    found = shutil.which("claude")
    if not found:
        raise SystemExit(
            'opencloddie: "claude" not found on PATH. Install Claude Code first '
            "(https://claude.com/claude-code)."
        )
    return found


def claude_config_dir() -> str:
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(
        os.path.expanduser("~"), ".claude"
    )


def claude_transcript_path(cwd: str, session_id: str) -> str:
    """Best-effort Claude Code transcript path for a working directory."""
    slug = re.sub(r"[^A-Za-z0-9]", "-", os.path.abspath(cwd))
    return os.path.join(claude_config_dir(), "projects", slug, f"{session_id}.jsonl")


def claude_transcript_exists(cwd: str, session_id: str) -> bool:
    if not cwd or not session_id:
        return False
    return os.path.isfile(claude_transcript_path(cwd, session_id))


CHAT_MIN_CLAUDE_VERSION = "2.1.300"
CHAT_DEFAULT_MAX_EVENT_BYTES = 256 * 1024
CHAT_DEFAULT_MAX_TOOL_RESULT_BYTES = 64 * 1024
CHAT_DEFAULT_PERMISSION_TIMEOUT = 3600
INTERNAL_CHAT_PREFIXES = (
    "[handback-send-enforce]",
    "[subagent-handback]",
    "[task-notification]",
)


def is_internal_chat_text(text: str) -> bool:
    """Harness/subagent instructions are model input, not user transcript."""
    value = str(text or "").lstrip()
    return bool(value) and value.startswith(INTERNAL_CHAT_PREFIXES)


def chat_paths(session_id: str) -> dict[str, str]:
    """Per-session files used by the structured-chat runtime."""
    base = state_dir()
    return {
        "mode": os.path.join(base, f"mode-{session_id}"),
        "launch": os.path.join(base, f"chat-launch-{session_id}.json"),
        "socket": os.path.join(base, f"chat-{session_id}.sock"),
        "token": os.path.join(base, f"chat-{session_id}.token"),
        "jsonl": os.path.join(base, f"chat-{session_id}.jsonl"),
        "log": os.path.join(base, f"chat-{session_id}.log"),
        "started": os.path.join(base, f"session-started-{session_id}"),
    }


def write_text_atomic(path: str, text: str, mode: int = 0o600) -> None:
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def read_mode(session_id: str, default: str = "tui") -> str:
    try:
        with open(chat_paths(session_id)["mode"], "r", encoding="utf-8") as fh:
            value = fh.read().strip()
    except OSError:
        return default
    return value if value in ("chat", "tui") else default


def write_mode(session_id: str, mode: str) -> None:
    write_text_atomic(chat_paths(session_id)["mode"], (mode if mode in ("chat", "tui") else "tui") + "\n")


def _version_tuple(text: str) -> tuple[int, int, int] | None:
    match = re.search(r"(\d+)\.(\d+)\.(\d+)", text or "")
    if not match:
        return None
    return tuple(int(part) for part in match.groups())


def claude_version(claude_bin: str) -> str | None:
    try:
        result = subprocess.run(
            [claude_bin, "--version"],
            capture_output=True,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    match = re.search(r"(\d+\.\d+\.\d+)", (result.stdout or "") + " " + (result.stderr or ""))
    return match.group(1) if match else None


def require_chat_claude(claude_bin: str) -> str:
    version = claude_version(claude_bin)
    minimum = _version_tuple(CHAT_MIN_CLAUDE_VERSION)
    parsed = _version_tuple(version or "")
    if parsed is None:
        raise SystemExit(
            "opencloddie: chat mode requires Claude Code >= "
            f"{CHAT_MIN_CLAUDE_VERSION}; could not determine `claude --version`."
        )
    if minimum is not None and parsed < minimum:
        raise SystemExit(
            "opencloddie: chat mode requires Claude Code >= "
            f"{CHAT_MIN_CLAUDE_VERSION} (found {version})."
        )
    return version or CHAT_MIN_CLAUDE_VERSION


def _arg_value(args: list[str], name: str) -> str | None:
    prefix = name + "="
    for index, arg in enumerate(args):
        if arg == name and index + 1 < len(args):
            return args[index + 1]
        if arg.startswith(prefix):
            return arg[len(prefix) :]
    return None


def web_session_url(cfg: dict, me: dict | None, session_id: str) -> str:
    base = (
        (me or {}).get("web_url")
        or cfg.get("web_url")
        or cfg.get("server")
        or ""
    ).rstrip("/")
    return f"{base}/#session={session_id}"


def signal_pane_child(tmux_name: str, sig: int = signal.SIGTERM) -> int:
    """Signal the mode supervisor's current child (claude or __chat)."""
    try:
        panes = subprocess.run(
            ["tmux", "list-panes", "-t", tmux_name, "-F", "#{pane_pid}"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if panes.returncode != 0:
            return 0
        for token in panes.stdout.split():
            if not token.isdigit():
                continue
            children = subprocess.run(
                ["pgrep", "-P", token], capture_output=True, text=True, timeout=5
            )
            for child in children.stdout.split():
                if not child.isdigit():
                    continue
                try:
                    os.kill(int(child), sig)
                    return int(child)
                except OSError:
                    continue
    except (OSError, subprocess.SubprocessError):
        pass
    return 0


def respawn_pane(tmux_name: str, cwd: str, session_id: str) -> bool:
    """Restart the tmux pane through the mode supervisor without dropping tmux."""
    runner = runner_path(session_id)
    if not os.path.exists(runner):
        return False
    try:
        result = subprocess.run(
            [
                "tmux",
                "respawn-pane",
                "-k",
                # `respawn-pane` does not accept a bare `=session` target;
                # the exact-match prefix works when a pane is named.
                "-t",
                f"={tmux_name}:0.0",
                "-c",
                cwd,
                "bash",
                runner,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return result.returncode == 0


def runner_path(session_id: str) -> str:
    # The cache copy is canonical (older clients and tests look for it); the
    # state copy matches the documented layout and is used on handoff.
    cached = os.path.join(cache_dir(), f"runner-{session_id}.sh")
    if os.path.exists(cached):
        return cached
    return os.path.join(state_dir(), f"runner-{session_id}.sh")


def cleanup_session_files(session_id: str) -> None:
    paths = chat_paths(session_id)
    candidates = [
        paths["mode"],
        paths["launch"],
        paths["socket"],
        paths["token"],
        paths["jsonl"],
        paths["log"],
        paths["started"],
        os.path.join(state_dir(), f"runner-{session_id}.sh"),
        os.path.join(cache_dir(), f"runner-{session_id}.sh"),
        os.path.join(cache_dir(), f"mcp-{session_id}.json"),
        os.path.join(cache_dir(), f"mcp-permissions-{session_id}.json"),
    ]
    for path in candidates:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        except OSError:
            pass


def gateway_env(cfg: dict, me: dict) -> dict[str, str]:
    model = me.get("model") or cfg.get("model") or "deepseek-v4.1-flash"
    env = {
        "ANTHROPIC_BASE_URL": norm_server(cfg["server"]),
        "ANTHROPIC_AUTH_TOKEN": cfg["api_key"],
        "ANTHROPIC_DEFAULT_OPUS_MODEL": model,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": model,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": model,
    }
    context = me.get("context_tokens")
    if context:
        env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = str(context)
    return env


def write_mcp_config(item: dict, cfg: dict, me: dict) -> str | None:
    """Write the per-session MCP server config Claude Code loads.

    The JSON contains no secret: the shim reads the client config file, which
    is already 0600.  It lives next to the runner in the cache directory.
    """
    if me.get("messages_enabled") is False:
        return None
    script = os.path.realpath(__file__)
    cfg_file = os.path.abspath(config_path())
    payload = {
        "mcpServers": {
            "opencloddie": {
                "type": "stdio",
                "command": sys.executable or "python3",
                "args": [
                    script,
                    "__mcp",
                    "--config",
                    cfg_file,
                    "--session-id",
                    item["id"],
                    "--name",
                    item.get("name") or "",
                ],
                "env": {
                    "OPENCLODDIE_CONFIG": cfg_file,
                    "OPENCLODDIE_SESSION_ID": item["id"],
                },
            }
        }
    }
    path = os.path.join(cache_dir(), f"mcp-{item['id']}.json")
    write_json(path, payload, mode=0o600)
    return path


def write_permission_mcp_config(item: dict, cfg: dict, me: dict, socket_path: str) -> str:
    """MCP config for the stream-json permission host.

    The server is named ``opencloddie_permissions`` so the tool is reachable as
    ``mcp__opencloddie_permissions__approval_prompt``.  It is always passed to
    the chat CLI alongside the mailbox server; Claude Code merges multiple
    ``--mcp-config`` flags.
    """
    script = os.path.realpath(__file__)
    cfg_file = os.path.abspath(config_path())
    payload = {
        "mcpServers": {
            "opencloddie_permissions": {
                "type": "stdio",
                "command": sys.executable or "python3",
                "args": [
                    script,
                    "__mcp",
                    "--config",
                    cfg_file,
                    "--session-id",
                    item["id"],
                    "--permission-only",
                    "--chat-socket",
                    socket_path,
                ],
                "env": {
                    "OPENCLODDIE_CONFIG": cfg_file,
                    "OPENCLODDIE_SESSION_ID": item["id"],
                },
            }
        }
    }
    path = os.path.join(cache_dir(), f"mcp-permissions-{item['id']}.json")
    write_json(path, payload, mode=0o600)
    return path


CHAT_MANAGED_FLAGS = {
    "-p",
    "--print",
    "--input-format",
    "--output-format",
    "--include-partial-messages",
    "--forward-subagent-text",
    "--replay-user-messages",
    "--prompt-suggestions",
    "--session-id",
    "--resume",
    "--continue",
    "-c",
    "--permission-mode",
    "--permission-prompt-tool",
    "--model",
}
CHAT_MANAGED_SWITCHES = {
    "-p", "--print", "--include-partial-messages", "--forward-subagent-text",
    "--replay-user-messages", "--prompt-suggestions", "--continue", "-c",
}


def filter_chat_args(args: list[str]) -> list[str]:
    """Drop flags the chat runner owns, keeping user MCP configs and tool rules."""
    out: list[str] = []
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--":
            out.extend(args[index:])
            break
        base = arg.split("=", 1)[0]
        if base in CHAT_MANAGED_FLAGS:
            if "=" not in arg and base not in CHAT_MANAGED_SWITCHES and index + 1 < len(args):
                index += 2
            else:
                index += 1
            continue
        out.append(arg)
        index += 1
    return out


def write_runner(
    item: dict, cfg: dict, me: dict, claude_args: list[str], *, mode: str = "tui"
) -> str:
    """Write the mode supervisor that runs either the chat runner or the TUI.

    The supervisor re-reads ``state_dir()/mode-<sid>`` after every child exit,
    so a handoff only has to rewrite that file and respawn the pane.
    """
    model = me.get("model") or cfg.get("model") or "deepseek-v4.1-flash"
    claude_bin = find_claude_bin(cfg)
    env = gateway_env(cfg, me)
    env["OPENCLODDIE_CONFIG"] = os.path.abspath(config_path())
    env["OPENCLODDIE_SESSION_ID"] = item["id"]
    paths = chat_paths(item["id"])
    mcp_path = write_mcp_config(item, cfg, me)
    permission_path = write_permission_mcp_config(item, cfg, me, paths["socket"])
    chat_cfg = me.get("chat") if isinstance(me.get("chat"), dict) else {}
    max_event_bytes = int(chat_cfg.get("max_event_bytes") or CHAT_DEFAULT_MAX_EVENT_BYTES)
    max_tool_result_bytes = int(
        chat_cfg.get("max_tool_result_bytes") or CHAT_DEFAULT_MAX_TOOL_RESULT_BYTES
    )
    permission_timeout = int(
        chat_cfg.get("permission_timeout_seconds") or CHAT_DEFAULT_PERMISSION_TIMEOUT
    )
    claude_session_id = item.get("claude_session_id") or str(uuid.uuid4())
    item["claude_session_id"] = claude_session_id
    # An empty mode means "let Claude Code use permissions.defaultMode", the
    # same setting the TUI honors.  Do not force "default" here.
    permission_mode = _arg_value(claude_args, "--permission-mode") or str(
        chat_cfg.get("permission_mode") or ""
    )
    chat_args = filter_chat_args(claude_args)
    launch = {
        "version": VERSION,
        "session_id": item["id"],
        "claude_session_id": claude_session_id,
        "resume": os.path.exists(paths["started"]),
        "model": model,
        "permission_mode": permission_mode,
        "user_claude_args": list(claude_args),
        "chat_claude_args": chat_args,
        "mailbox_mcp_config": mcp_path or "",
        "permission_mcp_config": permission_path,
        "cwd": item["cwd"],
        "mode": paths["mode"],
        "socket": paths["socket"],
        "token": paths["token"],
        "jsonl": paths["jsonl"],
        "log": paths["log"],
        "started_marker": paths["started"],
        "max_event_bytes": max_event_bytes,
        "max_tool_result_bytes": max_tool_result_bytes,
        "permission_timeout_seconds": permission_timeout,
        "claude_version": claude_version(claude_bin) if mode == "chat" else "",
    }
    write_json(paths["launch"], launch, mode=0o600)

    chat_cmd = [
        sys.executable or "python3",
        os.path.realpath(__file__),
        "__chat",
        "--config",
        os.path.abspath(config_path()),
        "--session-id",
        item["id"],
        "--launch",
        paths["launch"],
        "--log",
        paths["log"],
    ]
    tui_base = [claude_bin, "--model", model]
    if mcp_path:
        # Claude Code merges repeated --mcp-config flags; never skip ours just
        # because the user supplied one.
        tui_base += ["--mcp-config", mcp_path]
    tui_base += list(claude_args)
    # A user-supplied --resume/--continue owns the conversation selection;
    # adding our own --session-id/--resume would conflict.
    user_selects_session = any(
        arg in ("--resume", "-r", "--continue", "-c") or arg.startswith("--resume=")
        for arg in claude_args
    )
    if user_selects_session:
        tui_first = list(tui_base)
        tui_resume = list(tui_base)
    else:
        tui_first = list(tui_base) + ["--session-id", claude_session_id]
        tui_resume = list(tui_base) + ["--resume", claude_session_id]

    lines = [
        "#!/usr/bin/env bash",
        "# opencloddie-runner-v2",
        "set -u",
        f"cd -- {shlex.quote(item['cwd'])}",
    ]
    for key in (
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_MODEL",
        "ANTHROPIC_SMALL_FAST_MODEL",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS",
        "CLAUDE_CODE_USE_BEDROCK",
        "CLAUDE_CODE_USE_VERTEX",
        "CLAUDE_CODE_USE_FOUNDRY",
    ):
        lines.append(f"unset {key}")
    for key, value in env.items():
        lines.append(f"export {key}={shlex.quote(value)}")
    transcript = claude_transcript_path(item["cwd"], claude_session_id)
    lines += [
        f"MODE_FILE={shlex.quote(paths['mode'])}",
        f"STARTED={shlex.quote(paths['started'])}",
        f"TRANSCRIPT={shlex.quote(transcript)}",
        "while :; do",
        '  mode="$(cat "$MODE_FILE" 2>/dev/null || true)"',
        '  case "$mode" in',
        "    chat)",
        f"      {shlex.join(chat_cmd)}",
        "      rc=$?",
        "      sleep 0.5",
        "      # A handoff only rewrites the mode file and stops the child; loop",
        "      # back and start whichever mode is requested next.",
        "      continue",
        "      ;;",
        "    *)",
        '      : > "$STARTED" 2>/dev/null || true',
        "      while :; do",
        "        # Resume only when this id actually has a transcript; otherwise",
        "        # start a new one with the preassigned id.",
        '        if [ -f "$TRANSCRIPT" ]; then',
        f"          {shlex.join(tui_resume)}",
        "        else",
        f"          {shlex.join(tui_first)}",
        "        fi",
        "        printf '\\n[claude exited - press Enter to restart, Ctrl-b d to detach]\\n'",
        "        # Wait for Enter, but notice a chat handoff within a second so the",
        "        # pane can switch without being killed/respawned.",
        "        switched=0",
        "        while :; do",
        "          read -r -t 1 _; rc=$?",
        "          if [ \"$rc\" -eq 0 ]; then break; fi",
        "          if [ \"$rc\" -eq 1 ]; then exit 0; fi",
        '          if [ "$(cat "$MODE_FILE" 2>/dev/null || true)" != "tui" ]; then',
        "            switched=1",
        "            break",
        "          fi",
        "        done",
        '        [ "$switched" -eq 1 ] && break',
        "      done",
        "      ;;",
        "  esac",
        "done",
        "",
    ]
    text = "\n".join(lines)
    path = os.path.join(cache_dir(), f"runner-{item['id']}.sh")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(path, 0o700)
    try:
        state_runner = os.path.join(state_dir(), f"runner-{item['id']}.sh")
        with open(state_runner, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.chmod(state_runner, 0o700)
    except OSError:
        pass
    return path


RUNNER_MARKER = "# opencloddie-runner-v2"


def runner_is_current(session_id: str) -> bool:
    try:
        with open(runner_path(session_id), "r", encoding="utf-8") as fh:
            return RUNNER_MARKER in fh.read(4096)
    except OSError:
        return False


def start_local_session(
    cfg: dict,
    name: str,
    cwd: str,
    claude_args: list[str],
    *,
    force_new: bool,
    mode: str = "tui",
) -> tuple[str, dict, dict]:
    if not shutil.which("tmux"):
        raise SystemExit("opencloddie: tmux is required. Install it (e.g. `apt install tmux`).")
    if not os.path.isdir(cwd):
        raise SystemExit(f"opencloddie: working directory does not exist: {cwd}")
    mode = "chat" if mode == "chat" else "tui"
    me = api_call(cfg, "GET", "/client/me")
    if mode == "chat":
        features = me.get("features") if isinstance(me.get("features"), dict) else {}
        if not features.get("chat"):
            raise SystemExit(
                "opencloddie: this server does not support chat sessions yet.\n"
                "  Use `opencloddie run` (terminal mode) or upgrade the server, then retry."
            )
        require_chat_claude(find_claude_bin(cfg))
    sessions = load_sessions()
    session_id, item = find_or_create_mapping(sessions, name, cwd, force_new=force_new)
    previous_mode = item.get("mode") or read_mode(session_id, "tui")
    item["name"] = name
    item["cwd"] = cwd
    item["model"] = me.get("model", "")
    item["mode"] = mode
    if not item.get("claude_session_id"):
        item["claude_session_id"] = str(uuid.uuid4())
    fingerprint = hashlib.sha256(
        f"{cfg.get('api_key','')}|{item['model']}|{me.get('context_tokens')}".encode()
    ).hexdigest()[:12]
    running = tmux_has(item["tmux"])
    if running and item.get("fingerprint") and item["fingerprint"] != fingerprint:
        print(
            "opencloddie: warning: this session was started with a different API key/model.\n"
            "  The running Claude process keeps its old environment; restart with\n"
            f"  `opencloddie stop {shlex.quote(item['name'])}` and start it again to apply.",
            file=sys.stderr,
        )
    item["fingerprint"] = fingerprint
    save_sessions(sessions)

    if running and not runner_is_current(session_id):
        # One-time supervisor upgrade.  The mode file and Claude session id
        # survive, so the pane restarts into the same conversation.
        print(
            "opencloddie: upgrading this session's mode supervisor; "
            "the pane will restart once.",
            file=sys.stderr,
        )
        tmux_kill(item["tmux"])
        stop_agent(item)
        # The old runner removes its socket on shutdown.  Let it finish before
        # starting the replacement, or its cleanup can unlink the new socket.
        try:
            subprocess.run(
                ["pkill", "-TERM", "-f", f"__chat.*{session_id}"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=5,
            )
        except (OSError, subprocess.SubprocessError):
            pass
        socket_path = chat_paths(session_id)["socket"]
        deadline = time.time() + 10.0
        while time.time() < deadline:
            try:
                live = subprocess.run(
                    ["pgrep", "-f", f"__chat.*{session_id}"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    timeout=2,
                ).stdout.strip()
            except (OSError, subprocess.SubprocessError):
                live = ""
            if not live and not os.path.exists(socket_path):
                break
            time.sleep(0.1)
        running = False

    if not running:
        write_mode(session_id, mode)
        runner = write_runner(item, cfg, me, claude_args, mode=mode)
        result = subprocess.run(
            ["tmux", "new-session", "-d", "-s", item["tmux"], "-c", cwd, "--", "bash", runner],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise SystemExit(
                "opencloddie: could not create tmux session: "
                + (result.stderr.strip() or f"exit {result.returncode}")
            )
    elif previous_mode != mode or not os.path.exists(runner_path(session_id)):
        # Local mode switch: the supervisor notices the mode file and swaps
        # the child; do not respawn the pane (the kill signal raced).
        write_mode(session_id, mode)
        if not os.path.exists(runner_path(session_id)):
            write_runner(item, cfg, me, claude_args, mode=mode)
        signal_pane_child(item["tmux"])
        # Restart the agent so it wires up the new mode immediately.
        stop_agent(item)
    tmux_enable_mouse(item["tmux"])
    ensure_agent(cfg, item)
    if not me.get("opencode_key_set"):
        print(
            f"opencloddie: warning: no OpenCode key configured for {me.get('user', {}).get('username', 'this user')}.\n"
            f"  Add one at {me.get('web_url') or cfg.get('web_url') or cfg['server']} before Claude can answer.",
            file=sys.stderr,
        )
    return session_id, item, me


def ensure_agent(cfg: dict, item: dict, *, wait: bool = True) -> bool:
    pidfile = os.path.join(state_dir(), f"agent-{item['id']}.pid")
    logfile = os.path.join(state_dir(), f"agent-{item['id']}.log")
    try:
        with open(pidfile, "r", encoding="utf-8") as fh:
            pid = int(fh.read().strip() or 0)
    except (OSError, ValueError):
        pid = 0
    if pid and pid_is_agent(pid, item["id"]):
        return True
    try:
        if os.path.getsize(logfile) > 5 * 1024 * 1024:
            with open(logfile, "wb") as fh:
                fh.truncate(0)
    except OSError:
        pass
    script = os.path.realpath(__file__)
    env = dict(os.environ)
    env.pop("TMUX", None)
    cmd = [
        sys.executable,
        script,
        "__agent",
        "--config",
        config_path(),
        "--session-id",
        item["id"],
        "--tmux",
        item["tmux"],
        "--name",
        item["name"],
        "--cwd",
        item["cwd"],
        "--mode",
        item.get("mode") or read_mode(item["id"], "tui"),
        "--claude-session-id",
        item.get("claude_session_id") or "",
    ]
    log_handle = open(logfile, "ab")
    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            start_new_session=True,
            close_fds=True,
            env=env,
        )
    finally:
        log_handle.close()
    with open(pidfile, "w", encoding="utf-8") as fh:
        fh.write(str(proc.pid))
    item["agent_pid"] = proc.pid
    item["log"] = logfile
    if wait:
        _wait_online(cfg, item["id"], logfile, timeout=10)
    return True


def _wait_online(cfg: dict, session_id: str, logfile: str, timeout: float) -> None:
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            data = api_call(cfg, "GET", "/client/sessions", timeout=5)
            for session in data.get("sessions", []):
                if session.get("id") == session_id and session.get("online"):
                    return
        except ApiError:
            pass
        time.sleep(0.5)
    print("opencloddie: session is running locally, but the web agent has not registered yet.", file=sys.stderr)
    print(f"  agent log: {logfile}", file=sys.stderr)
    try:
        with open(logfile, "r", encoding="utf-8", errors="replace") as fh:
            tail = fh.read()[-1200:]
        if tail.strip():
            print("  " + tail.strip().replace("\n", "\n  "), file=sys.stderr)
    except OSError:
        pass


def stop_agent(item: dict) -> None:
    pidfile = os.path.join(state_dir(), f"agent-{item['id']}.pid")
    pid = 0
    try:
        with open(pidfile, "r", encoding="utf-8") as fh:
            pid = int(fh.read().strip() or 0)
    except (OSError, ValueError):
        pass
    if pid and pid_is_agent(pid, item["id"]):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        deadline = time.time() + 3
        while time.time() < deadline and pid_alive(pid):
            time.sleep(0.1)
        if pid_alive(pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    try:
        os.unlink(pidfile)
    except OSError:
        pass


