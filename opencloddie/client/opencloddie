# --------------------------------------------------------------------------
# WebSocket client (standalone; mirrors the server's protocol)
# --------------------------------------------------------------------------
GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
OP_CONT, OP_TEXT, OP_BINARY, OP_CLOSE, OP_PING, OP_PONG = 0, 1, 2, 8, 9, 10


class WSClosed(Exception):
    pass


class WSClient:
    """WebSocket client driven by a single thread.

    Python's SSLSocket is not safe for a blocking read and a write at the
    same time: under load the two threads corrupt the TLS record stream and
    the peer closes with a bad-record-mac alert.  That is what used to drop
    the agent whenever a busy terminal pushed output while the heartbeat or
    a keystroke was being sent.  All socket I/O now happens in the thread
    that calls recv(); other threads enqueue frames and wake it through a
    pipe.
    """

    MAX_OUTBOX = 8 * 1024 * 1024
    MAX_MESSAGE = 16 * 1024 * 1024

    def __init__(self, sock, rfile):
        self.sock = sock
        self.rfile = rfile  # used only during the HTTP upgrade
        self.lock = threading.Lock()
        self.closed = False
        self._outbox = collections.deque()
        self._outbox_bytes = 0
        self._inbuf = bytearray()
        self._messages = collections.deque()
        self._partial = []
        self._partial_opcode = None
        self._partial_bytes = 0
        self._socket_closed = False
        self._want_write = False
        self._close_deadline = float("inf")
        self._io_lock = threading.Lock()
        self._wake_r, self._wake_w = os.pipe()
        os.set_blocking(self._wake_r, False)
        os.set_blocking(self._wake_w, False)
        try:
            sock.setblocking(False)
        except OSError:
            pass

    @classmethod
    def connect(cls, url: str, headers: dict | None = None, timeout: float | None = 20.0):
        parts = urllib.parse.urlsplit(url)
        secure = parts.scheme in ("wss", "https")
        host = parts.hostname or ""
        port = parts.port or (443 if secure else 80)
        path = parts.path or "/"
        if parts.query:
            path += "?" + parts.query
        raw = socket.create_connection((host, port), timeout=timeout)
        if secure:
            raw = ssl.create_default_context().wrap_socket(raw, server_hostname=host)
        key = base64.b64encode(os.urandom(16)).decode("ascii")
        lines = [
            f"GET {path} HTTP/1.1",
            f"Host: {host}:{port}",
            "Upgrade: websocket",
            "Connection: Upgrade",
            f"Sec-WebSocket-Key: {key}",
            "Sec-WebSocket-Version: 13",
            f"User-Agent: {USER_AGENT}",
        ]
        for name, value in (headers or {}).items():
            lines.append(f"{name}: {value}")
        raw.sendall(("\r\n".join(lines) + "\r\n\r\n").encode("latin-1"))
        rfile = raw.makefile("rb")
        status = rfile.readline()
        if not status:
            raw.close()
            raise WSClosed("empty handshake response")
        if b" 101 " not in status:
            body = rfile.read(512).decode("utf-8", "replace")
            raw.close()
            raise WSClosed(f"handshake failed: {status.decode('latin-1').strip()} {body}")
        accept = None
        while True:
            line = rfile.readline()
            if line in (b"\r\n", b"\n", b""):
                break
            name, _, value = line.decode("latin-1").partition(":")
            if name.strip().lower() == "sec-websocket-accept":
                accept = value.strip()
        import hashlib

        expected = base64.b64encode(hashlib.sha1((key + GUID).encode()).digest()).decode()
        if accept != expected:
            raw.close()
            raise WSClosed("invalid Sec-WebSocket-Accept")
        return cls(raw, rfile)

    def send(self, opcode: int, payload: bytes) -> None:
        frame = _encode(opcode, payload, mask=True)
        with self.lock:
            if self.closed:
                raise WSClosed("closed")
            if opcode < OP_CLOSE and self._outbox_bytes + len(frame) > self.MAX_OUTBOX:
                # The peer is not draining; drop new data rather than grow
                # without bound (the agent's PTY pump would otherwise stall).
                return
            self._outbox.append(frame)
            self._outbox_bytes += len(frame)
        self._wake()

    def send_json(self, obj: dict) -> None:
        self.send(OP_TEXT, json.dumps(obj, separators=(",", ":")).encode("utf-8"))

    def recv(self):
        """Return the next complete message, doing all socket I/O here."""
        with self._io_lock:
            return self._recv_locked()

    def _recv_locked(self):
        while True:
            if self._messages:
                return self._messages.popleft()
            if self.closed:
                try:
                    self._flush()
                except WSClosed:
                    pass
                with self.lock:
                    drained = not self._outbox
                if drained or time.monotonic() >= self._close_deadline:
                    self._shutdown()
                    raise WSClosed("closed")
            wlist = [self.sock] if (self._outbox or self._want_write) else []
            try:
                readable, writable, _ = select.select([self.sock, self._wake_r], wlist, [], 1.0)
            except (OSError, ValueError) as exc:
                self._shutdown()
                raise WSClosed(f"select failed: {exc}") from exc
            if self._wake_r in readable:
                self._drain_wake()
            if self.sock in writable:
                try:
                    self._flush()
                except WSClosed:
                    self._shutdown()
                    raise
            if self.sock in readable:
                try:
                    self._read_available()
                except WSClosed:
                    self._shutdown()
                    raise

    def close(self) -> None:
        with self.lock:
            if self.closed:
                return
            self.closed = True
            self._close_deadline = time.monotonic() + 2.0
            frame = _encode(OP_CLOSE, struct.pack("!H", 1000), mask=True)
            self._outbox.append(frame)
            self._outbox_bytes += len(frame)
        self._wake()

    def wait_closed(self, timeout: float = 1.5) -> None:
        """Flush a queued close frame, then release the socket."""
        with self._io_lock:
            self._wait_closed_locked(timeout)

    def _wait_closed_locked(self, timeout: float) -> None:
        deadline = time.monotonic() + timeout
        while True:
            with self.lock:
                if self._socket_closed:
                    return
                drained = not self._outbox
            if not drained:
                try:
                    self._flush()
                except WSClosed:
                    break
                with self.lock:
                    drained = not self._outbox
            if drained or time.monotonic() >= deadline:
                break
            try:
                select.select([self.sock], [self.sock], [], 0.05)
            except (OSError, ValueError):
                break
        self._shutdown()

    # ------------------------------------------------------------- internals
    def _wake(self) -> None:
        try:
            os.write(self._wake_w, b"\0")
        except (BlockingIOError, OSError):
            pass

    def _drain_wake(self) -> None:
        try:
            while os.read(self._wake_r, 4096):
                pass
        except (BlockingIOError, OSError):
            pass

    def _flush(self) -> None:
        while True:
            with self.lock:
                if not self._outbox:
                    self._want_write = False
                    return
                chunk = self._outbox[0]
            try:
                written = self.sock.send(chunk)
            except (ssl.SSLWantWriteError, BlockingIOError):
                self._want_write = True
                return
            except ssl.SSLWantReadError:
                self._want_write = False
                return
            except (OSError, ValueError) as exc:
                raise WSClosed(f"socket send failed: {exc}") from exc
            if written <= 0:
                raise WSClosed("socket closed during send")
            with self.lock:
                if written >= len(chunk):
                    self._outbox.popleft()
                    self._outbox_bytes -= len(chunk)
                else:
                    self._outbox[0] = chunk[written:]
                    self._outbox_bytes -= written
            self._want_write = False

    def _read_available(self) -> None:
        while True:
            try:
                data = self.sock.recv(65536)
            except (ssl.SSLWantReadError, BlockingIOError):
                break
            except ssl.SSLWantWriteError:
                self._want_write = True
                break
            except (OSError, ValueError) as exc:
                raise WSClosed(f"socket read failed: {exc}") from exc
            if not data:
                raise WSClosed("unexpected EOF")
            self._inbuf.extend(data)
        self._parse()

    def _parse(self) -> None:
        while True:
            if len(self._inbuf) < 2:
                return
            b1, b2 = self._inbuf[0], self._inbuf[1]
            fin = bool(b1 & 0x80)
            opcode = b1 & 0x0F
            masked = bool(b2 & 0x80)
            n = b2 & 0x7F
            offset = 2
            if n == 126:
                if len(self._inbuf) < 4:
                    return
                n = struct.unpack("!H", self._inbuf[2:4])[0]
                offset = 4
            elif n == 127:
                if len(self._inbuf) < 10:
                    return
                n = struct.unpack("!Q", self._inbuf[2:10])[0]
                offset = 10
            if n > self.MAX_MESSAGE:
                raise WSClosed("frame too large")
            key = b""
            if masked:
                if len(self._inbuf) < offset + 4:
                    return
                key = bytes(self._inbuf[offset : offset + 4])
                offset += 4
            if len(self._inbuf) < offset + n:
                return
            payload = bytes(self._inbuf[offset : offset + n])
            del self._inbuf[: offset + n]
            if masked:
                payload = _mask_payload(payload, key)
            if opcode == OP_CLOSE:
                raise WSClosed("server closed")
            if opcode == OP_PING:
                self.send(OP_PONG, payload)
                continue
            if opcode == OP_PONG:
                continue
            if opcode == OP_CONT:
                if self._partial_opcode is None:
                    raise WSClosed("bad continuation")
            else:
                if self._partial_opcode is not None:
                    raise WSClosed("interleaved message")
                self._partial_opcode = opcode
            self._partial.append(payload)
            self._partial_bytes += len(payload)
            if self._partial_bytes > self.MAX_MESSAGE:
                raise WSClosed("message too large")
            if fin:
                self._messages.append((self._partial_opcode, b"".join(self._partial)))
                self._partial = []
                self._partial_opcode = None
                self._partial_bytes = 0

    def _shutdown(self) -> None:
        with self.lock:
            if self._socket_closed:
                return
            self._socket_closed = True
            self.closed = True
            self._outbox.clear()
            self._outbox_bytes = 0
        try:
            self.sock.close()
        except OSError:
            pass
        for fd in (self._wake_r, self._wake_w):
            try:
                os.close(fd)
            except OSError:
                pass


def _mask_payload(payload: bytes, key: bytes) -> bytes:
    n = len(payload)
    if not n:
        return payload
    stream = (key * ((n + 3) // 4))[:n]
    return (int.from_bytes(payload, "big") ^ int.from_bytes(stream, "big")).to_bytes(n, "big")


def _encode(opcode: int, payload: bytes, *, mask: bool) -> bytes:
    n = len(payload)
    first = 0x80 | opcode
    second = 0x80 if mask else 0
    if n < 126:
        header = bytes([first, second | n])
    elif n < 65536:
        header = bytes([first, second | 126]) + struct.pack("!H", n)
    else:
        header = bytes([first, second | 127]) + struct.pack("!Q", n)
    if not mask:
        return header + payload
    key = os.urandom(4)
    return header + key + _mask_payload(payload, key)


# --------------------------------------------------------------------------
# PTY helpers (standalone)
# --------------------------------------------------------------------------
MAX_PENDING_INPUT = 256 * 1024


class Pty:
    def __init__(self, master: int, proc: subprocess.Popen):
        self.master = master
        self.proc = proc
        self.closed = False
        try:
            os.set_blocking(self.master, False)
        except OSError:
            pass
        self._pending = bytearray()
        self._pending_lock = threading.Lock()
        self._flusher: threading.Thread | None = None

    def resize(self, cols: int, rows: int) -> None:
        try:
            fcntl.ioctl(
                self.master,
                termios.TIOCSWINSZ,
                struct.pack("HHHH", max(2, min(int(rows), 1000)), max(2, min(int(cols), 1000)), 0, 0),
            )
        except OSError:
            pass

    def write(self, data: bytes) -> None:
        """Queue input for the pane without blocking the WebSocket reader.

        A synchronous write blocks once the pane's input buffer is full (for
        example during a fast wheel scroll while the TUI is redrawing).  That
        stalls the agent's frame reader, which in turn blocks the server's
        writes and eventually drops the agent connection.  Buffer a bounded
        amount and let a small writer thread drain it instead.
        """
        with self._pending_lock:
            if self.closed:
                return
            if len(self._pending) + len(data) > MAX_PENDING_INPUT:
                # Overwhelmed input (usually repeat scroll events) is dropped
                # rather than growing memory without bound.
                return
            self._pending += data
            if self._flusher is None:
                self._flusher = threading.Thread(
                    target=self._flush_loop,
                    name=f"pty-write-{self.master}",
                    daemon=True,
                )
                self._flusher.start()

    def _flush_loop(self) -> None:
        while True:
            with self._pending_lock:
                if self.closed or not self._pending:
                    self._pending.clear()
                    self._flusher = None
                    return
                chunk = bytes(self._pending)
            try:
                written = os.write(self.master, chunk)
            except (BlockingIOError, InterruptedError):
                try:
                    select.select([], [self.master], [], 0.2)
                except (OSError, ValueError):
                    with self._pending_lock:
                        self._pending.clear()
                        self._flusher = None
                    return
                continue
            except OSError:
                with self._pending_lock:
                    self._pending.clear()
                    self._flusher = None
                return
            if written <= 0:
                with self._pending_lock:
                    self._pending.clear()
                    self._flusher = None
                return
            with self._pending_lock:
                del self._pending[:written]

    def close(self) -> None:
        with self._pending_lock:
            self.closed = True
            self._pending.clear()
        try:
            if self.proc.poll() is None:
                self.proc.terminate()
                try:
                    self.proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    self.proc.kill()
        finally:
            try:
                os.close(self.master)
            except OSError:
                pass


def spawn_pty(argv: list[str], cols: int, rows: int) -> Pty:
    master, slave = pty.openpty()
    try:
        fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
        env = dict(os.environ)
        env["TERM"] = env.get("TERM") or "xterm-256color"
        env.pop("TMUX", None)
        proc = subprocess.Popen(
            argv,
            stdin=slave,
            stdout=slave,
            stderr=slave,
            env=env,
            start_new_session=True,
            preexec_fn=_make_controlling_tty,
            close_fds=True,
        )
    except Exception:
        os.close(master)
        os.close(slave)
        raise
    os.close(slave)
    return Pty(master, proc)


def pump_pty(proc: Pty, on_data, stop: threading.Event) -> None:
    while not stop.is_set():
        try:
            ready, _, _ = select.select([proc.master], [], [], 0.2)
        except (OSError, ValueError):
            break
        if not ready:
            if proc.proc.poll() is not None:
                break
            continue
        try:
            data = os.read(proc.master, 65536)
        except (BlockingIOError, InterruptedError):
            continue
        except OSError:
            break
        if not data:
            break
        try:
            on_data(data)
        except Exception:  # noqa: BLE001
            break


TIOCSCTTY = getattr(termios, "TIOCSCTTY", None)


def _make_controlling_tty() -> None:
    """Make the PTY slave the child's controlling terminal.

    Without TIOCSCTTY the kernel does not deliver SIGWINCH to `tmux attach`,
    so browser resizes change the PTY size but tmux never resizes its client.
    Runs in the forked child before exec.
    """
    if TIOCSCTTY is None:
        return
    try:
        fcntl.ioctl(0, TIOCSCTTY, 0)
    except OSError:
        pass


# --------------------------------------------------------------------------
# newline-delimited JSON over a Unix socket (agent <-> chat runner <-> MCP)
# --------------------------------------------------------------------------
CHAT_MAX_LINE = 16 * 1024 * 1024


class LineConn:
    """Thread-safe newline-delimited JSON connection."""

    def __init__(self, sock, rfile=None):
        self.sock = sock
        self.rfile = rfile or sock.makefile("rb")
        self.lock = threading.Lock()
        self.closed = False

    @classmethod
    def connect_unix(cls, path: str, timeout: float = 5.0) -> "LineConn":
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        sock.connect(path)
        sock.settimeout(None)
        return cls(sock)

    def send(self, obj: dict) -> None:
        data = json.dumps(obj, separators=(",", ":")).encode("utf-8") + b"\n"
        with self.lock:
            if self.closed:
                raise OSError("connection closed")
            self.sock.sendall(data)

    def recv(self):
        while True:
            try:
                line = self.rfile.readline(CHAT_MAX_LINE + 1)
            except (OSError, ValueError):
                return None
            if not line:
                return None
            if len(line) > CHAT_MAX_LINE and not line.endswith(b"\n"):
                # Split-safe: discard the rest of an oversized line.
                while True:
                    more = self.rfile.readline(CHAT_MAX_LINE + 1)
                    if not more or more.endswith(b"\n"):
                        break
                continue
            line = line.strip()
            if not line:
                continue
            try:
                value = json.loads(line.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError):
                return {}
            return value if isinstance(value, dict) else {}

    def close(self) -> None:
        with self.lock:
            if self.closed:
                return
            self.closed = True
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass


# --------------------------------------------------------------------------
# agent
# --------------------------------------------------------------------------
class Agent:
    def __init__(self, args: argparse.Namespace):
        self.config_file = args.config
        self.session_id = args.session_id
        self.tmux = args.tmux
        self.name = args.name
        self.cwd = args.cwd
        self.agent_id = args.agent_id or ("a-" + secrets.token_hex(8))
        self.stop_event = threading.Event()
        self.ws: WSClient | None = None
        self.ws_lock = threading.Lock()
        self.channels: dict[int, tuple[Pty, threading.Event]] = {}
        self.channels_lock = threading.Lock()
        self.features: dict[str, bool] = {
            "mouse": False,
            "chat": True,
            "chat_version": 1,
        }
        self._send_warned = False
        # Structured-chat relay state.  `mode` mirrors state_dir()/mode-<sid>;
        # the runner and the agent both treat it as the source of truth.
        self.mode = getattr(args, "mode", "") or read_mode(self.session_id, "tui")
        self.claude_session_id = getattr(args, "claude_session_id", "") or ""
        self.chat_link: LineConn | None = None
        self.chat_link_lock = threading.Lock()
        self.chat_connected = False
        self.chat_epoch = ""
        self.chat_last_local_seq = 0
        self.chat_hello_payload: dict | None = None
        self.chat_sync_pending = False
        self.chat_recent_resolved: list[dict] = []
        self.chat_pending: dict[str, dict] = {}
        self.chat_pending_lock = threading.Lock()
        self.chat_pending_results: dict[str, dict] = {}
        self.handoff_lock = threading.Lock()
        self.handoff_active = False

    def log(self, message: str) -> None:
        stamp = time.strftime("%H:%M:%S")
        print(f"[{stamp}] {message}", file=sys.stderr, flush=True)

    def _cfg(self) -> dict:
        cfg = read_json(self.config_file, {}) or {}
        if not cfg.get("server") or not cfg.get("api_key"):
            raise SystemExit("agent: config disappeared or is incomplete")
        return cfg

    def run(self) -> int:
        self.features["mouse"] = tmux_enable_mouse(self.tmux)
        threading.Thread(target=self._monitor, name="monitor", daemon=True).start()
        threading.Thread(target=self._chat_supervisor, name="chat", daemon=True).start()
        backoff = 1.0
        while not self.stop_event.is_set():
            if not tmux_has(self.tmux):
                self.log(f"tmux session {self.tmux} is gone; exiting")
                self.stop()
                break
            started = time.monotonic()
            try:
                self._session()
                backoff = 1.0
            except WSClosed as exc:
                if self.stop_event.is_set():
                    break
                text = str(exc)
                self.log(f"websocket closed: {text}")
                if "401" in text or "403" in text:
                    self.log("authentication failed; retrying in 60s (check `opencloddie login`)")
                    if self.stop_event.wait(60):
                        break
                    continue
            except Exception as exc:  # noqa: BLE001
                if self.stop_event.is_set():
                    break
                self.log(f"connection error: {type(exc).__name__}: {exc}")
            # A connection that stayed up for a while was healthy; start its
            # retry delay over instead of letting backoff ratchet to 30s for
            # the rest of the process's lifetime.
            if time.monotonic() - started >= 30:
                backoff = 1.0
            if self.stop_event.is_set():
                break
            self.stop_event.wait(backoff)
            backoff = min(30.0, backoff * 2)
        self._close_all_channels()
        self.log("agent stopped")
        return 0

    def stop(self) -> None:
        self.stop_event.set()
        with self.ws_lock:
            ws = self.ws
            self.ws = None
        if ws:
            try:
                ws.close()
            except Exception:  # noqa: BLE001
                pass
        self._close_chat_link()
        self._close_all_channels()

    def _monitor(self) -> None:
        misses = 0
        while not self.stop_event.wait(10):
            if tmux_has(self.tmux):
                misses = 0
            else:
                misses += 1
                if misses >= 3:
                    self.log("tmux session disappeared; stopping agent")
                    self.stop()
                    return

    def _session(self) -> None:
        cfg = self._cfg()
        server = norm_server(cfg["server"])
        url = server + "/agent/ws?agent_id=" + urllib.parse.quote(self.agent_id)
        self.log(f"connecting to {server}")
        ws = WSClient.connect(url, headers={"Authorization": f"Bearer {cfg['api_key']}"}, timeout=20)
        self._send_warned = False
        # The I/O loop is non-blocking and woken by writes; liveness comes
        # from the 20s heartbeat, not a socket read timeout.
        with self.ws_lock:
            self.ws = ws
        ws.send_json(
            {
                "t": "hello",
                "agent_id": self.agent_id,
                "version": VERSION,
                "hostname": socket.gethostname(),
                "platform": sys.platform,
                "features": self.features,
                "session": {
                    "id": self.session_id,
                    "name": self.name,
                    "cwd": self.cwd,
                    "mode": self.mode,
                    "claude_session_id": self.claude_session_id,
                },
            }
        )
        welcome_seen = False
        heartbeat = threading.Thread(target=self._heartbeat, args=(ws,), name="heartbeat", daemon=True)
        heartbeat.start()
        try:
            while not self.stop_event.is_set():
                opcode, payload = ws.recv()
                if opcode != OP_TEXT:
                    continue
                try:
                    message = json.loads(payload.decode("utf-8"))
                except (UnicodeDecodeError, json.JSONDecodeError):
                    continue
                kind = message.get("t")
                if kind == "welcome":
                    welcome_seen = True
                    self.log(f"registered session {self.session_id} (model {message.get('model')})")
                    self._resend_chat_hello()
                elif kind == "chat_input":
                    self._chat_command(
                        {"t": "input", "client_msg_id": message.get("client_msg_id"), "content": message.get("content")}
                    )
                elif kind == "chat_permission_result":
                    self._chat_command(
                        {
                            "t": "permission_result",
                            "permission_id": message.get("permission_id"),
                            "result": message.get("result"),
                        }
                    )
                elif kind == "chat_interrupt":
                    self._chat_command({"t": "interrupt", "request_id": message.get("request_id")})
                elif kind == "chat_config":
                    self._chat_command(
                        {
                            "t": "config",
                            "permission_mode": message.get("permission_mode"),
                            "model": message.get("model"),
                            "force": bool(message.get("force")),
                        }
                    )
                elif kind == "chat_rewind":
                    self._chat_command(
                        {
                            "t": "rewind",
                            "checkpoint_uuid": message.get("checkpoint_uuid"),
                            "force": bool(message.get("force")),
                        }
                    )
                elif kind == "chat_resync":
                    self._chat_command(
                        {
                            "t": "sync",
                            "epoch": self.chat_epoch,
                            "after": int(message.get("since_local_seq") or 0),
                        }
                    )
                elif kind == "chat_ack":
                    self._chat_command(
                        {"t": "ack", "up_to_local_seq": int(message.get("up_to_local_seq") or 0)}
                    )
                elif kind == "chat_handoff":
                    threading.Thread(
                        target=self._handle_handoff,
                        args=(message.get("to"), bool(message.get("force"))),
                        name="handoff",
                        daemon=True,
                    ).start()
                elif kind == "open":
                    self._open_channel(message)
                elif kind == "in":
                    channel = self.channels.get(int(message.get("ch", -1)))
                    if channel:
                        try:
                            channel[0].write(base64.b64decode(message.get("data", "")))
                        except Exception:  # noqa: BLE001
                            pass
                elif kind == "resize":
                    channel = self.channels.get(int(message.get("ch", -1)))
                    if channel:
                        channel[0].resize(int(message.get("cols", 80)), int(message.get("rows", 24)))
                elif kind == "get_buffer":
                    self._send_buffer(int(message.get("ch", -1)))
                elif kind == "close":
                    self._close_channel(int(message.get("ch", -1)))
                elif kind == "kill":
                    self.log("server requested kill; stopping session")
                    tmux_kill(self.tmux)
                    self.stop()
                    return
                elif kind == "pong":
                    pass
        finally:
            with self.ws_lock:
                if self.ws is ws:
                    self.ws = None
            self._close_all_channels()
            try:
                ws.close()
                ws.wait_closed()
            except Exception:  # noqa: BLE001
                pass
            if not welcome_seen:
                self.log("connection closed before registration")

    def _heartbeat(self, ws: WSClient) -> None:
        while not self.stop_event.wait(20):
            try:
                ws.send_json({"t": "ping", "ts": time.time()})
            except WSClosed:
                return
            except Exception as exc:  # noqa: BLE001
                self.log(f"heartbeat stopped: {type(exc).__name__}: {exc}")
                return

    # -------------------------------------------------------------- chat relay
    def _close_chat_link(self) -> None:
        with self.chat_link_lock:
            link = self.chat_link
            self.chat_link = None
            self.chat_connected = False
        if link is not None:
            try:
                link.close()
            except Exception:  # noqa: BLE001
                pass

    def _set_chat_link(self, link: LineConn | None) -> None:
        with self.chat_link_lock:
            old = self.chat_link
            self.chat_link = link
            self.chat_connected = link is not None
        if old is not None and old is not link:
            try:
                old.close()
            except Exception:  # noqa: BLE001
                pass

    def _chat_send(self, obj: dict) -> bool:
        with self.chat_link_lock:
            link = self.chat_link
        if link is None:
            return False
        try:
            link.send(obj)
            return True
        except (OSError, ValueError):
            self._close_chat_link()
            return False

    def _chat_command(self, obj: dict) -> None:
        kind = obj.get("t")
        permission_id = str(obj.get("permission_id") or "")
        if kind == "permission_result" and permission_id:
            with self.chat_pending_lock:
                self.chat_pending_results[permission_id] = obj
        if self._chat_send(obj):
            if kind == "permission_result" and permission_id:
                with self.chat_pending_lock:
                    self.chat_pending_results.pop(permission_id, None)
            return
        if kind != "permission_result":
            self._send(
                {
                    "t": "chat_error",
                    "message": "chat runner is not connected; retry",
                    "retryable": True,
                }
            )

    def _flush_pending_results(self) -> None:
        with self.chat_pending_lock:
            items = list(self.chat_pending_results.items())
        for permission_id, obj in items:
            if self._chat_send(obj):
                with self.chat_pending_lock:
                    self.chat_pending_results.pop(permission_id, None)

    def _chat_supervisor(self) -> None:
        backoff = 0.5
        while not self.stop_event.is_set():
            if self.mode != "chat":
                self._close_chat_link()
                backoff = 0.5
                self.stop_event.wait(0.5)
                continue
            paths = chat_paths(self.session_id)
            token = ""
            try:
                with open(paths["token"], "r", encoding="utf-8") as fh:
                    token = fh.read().strip()
            except OSError:
                token = ""
            if not token or not os.path.exists(paths["socket"]):
                self.stop_event.wait(0.5)
                continue
            link: LineConn | None = None
            try:
                link = LineConn.connect_unix(paths["socket"], timeout=5)
                link.send({"t": "hello", "role": "agent", "token": token})
                hello = link.recv()
                if not hello or hello.get("t") != "hello_ok":
                    raise OSError("chat runner rejected the agent hello")
                self._set_chat_link(link)
                self.chat_epoch = str(hello.get("run_id") or "")
                self.chat_last_local_seq = int(hello.get("last_local_seq") or 0)
                self._publish_chat_hello(hello)
                self._flush_pending_results()
                backoff = 0.5
                self._chat_read_loop(link)
            except (OSError, ValueError) as exc:
                if not self.stop_event.is_set() and self.mode == "chat":
                    self.log(f"chat socket: {type(exc).__name__}: {exc}")
            finally:
                with self.chat_link_lock:
                    current = self.chat_link
                if current is link:
                    self._close_chat_link()
                elif link is not None:
                    try:
                        link.close()
                    except Exception:  # noqa: BLE001
                        pass
            if self.stop_event.wait(backoff):
                break
            backoff = min(5.0, backoff * 2)

    def _publish_chat_hello(self, hello: dict) -> None:
        run_id = str(hello.get("run_id") or self.chat_epoch or "")
        claude_session_id = str(
            hello.get("claude_session_id") or self.claude_session_id or ""
        )
        if claude_session_id:
            self.claude_session_id = claude_session_id
        pending: list[dict] = []
        runner_pending = hello.get("pending")
        if isinstance(runner_pending, list):
            rebuilt: dict[str, dict] = {}
            for entry in runner_pending:
                if not isinstance(entry, dict):
                    continue
                permission_id = str(entry.get("permission_id") or entry.get("id") or "")
                if not permission_id:
                    continue
                item = dict(entry)
                item["id"] = permission_id
                item["permission_id"] = permission_id
                rebuilt[permission_id] = item
            with self.chat_pending_lock:
                self.chat_pending = rebuilt
        with self.chat_pending_lock:
            pending = list(self.chat_pending.values())
        payload = {
            "t": "chat_hello",
            "run_id": run_id,
            "claude_session_id": claude_session_id,
            "model": str(hello.get("model") or ""),
            "permission_mode": str(hello.get("permission_mode") or "default"),
            "status": str(hello.get("status") or "idle"),
            "claude_version": str(hello.get("claude_version") or ""),
            "capabilities": hello.get("capabilities") or {},
            "pending": pending,
            "last_local_seq": int(hello.get("last_local_seq") or 0),
        }
        self.chat_hello_payload = payload
        resolved = hello.get("resolved")
        if isinstance(resolved, list):
            self.chat_recent_resolved = [
                item for item in resolved if isinstance(item, dict)
            ]
        self._send(payload)
        self._send_recent_resolved()
        self.chat_sync_pending = True
        self._maybe_send_chat_sync()

    def _maybe_send_chat_sync(self) -> None:
        """Ask the runner to replay its local ring after a (re)connect.

        The hub dedupes by event_id, so replaying the bounded ring is safe and
        repairs events emitted while the agent's hub socket was down.
        """
        if not self.chat_sync_pending or not self.chat_connected:
            return
        with self.ws_lock:
            if self.ws is None:
                return
        if self._chat_send({"t": "sync", "epoch": self.chat_epoch, "after": 0}):
            self.chat_sync_pending = False

    def _send_recent_resolved(self) -> None:
        if not self.chat_recent_resolved:
            return
        with self.ws_lock:
            if self.ws is None:
                # Keep them; the next hub connection resends the hello and
                # these repair frames.
                return
        pending = list(self.chat_recent_resolved)
        self.chat_recent_resolved = []
        for item in pending:
            permission_id = str(item.get("permission_id") or "")
            if not permission_id:
                continue
            self._send(
                {
                    "t": "chat_permission_resolved",
                    "permission_id": permission_id,
                    "status": item.get("status") or "denied",
                    "decision": item.get("decision") or {},
                    "resolved_by": item.get("resolved_by") or "runner",
                }
            )

    def _resend_chat_hello(self) -> None:
        if self.chat_connected and self.chat_hello_payload:
            self._send(self.chat_hello_payload)
            self._send_recent_resolved()
            self.chat_sync_pending = True
            self._maybe_send_chat_sync()

    def _chat_read_loop(self, link: LineConn) -> None:
        while not self.stop_event.is_set() and self.mode == "chat":
            message = link.recv()
            if message is None:
                return
            kind = message.get("t")
            if kind == "event":
                if message.get("local_seq") is not None:
                    try:
                        self.chat_last_local_seq = max(
                            self.chat_last_local_seq, int(message["local_seq"])
                        )
                    except (TypeError, ValueError):
                        pass
                self._send(
                    {
                        "t": "chat_event",
                        "event_id": message.get("event_id"),
                        "kind": message.get("kind"),
                        "turn_id": message.get("turn_id") or "",
                        "payload": message.get("payload") or {},
                        "created_at": message.get("created_at") or "",
                    }
                )
            elif kind == "delta":
                self._send(
                    {
                        "t": "chat_delta",
                        "turn_id": message.get("turn_id") or "",
                        "parent_tool_use_id": message.get("parent_tool_use_id"),
                        "message_id": message.get("message_id") or "",
                        "block_index": message.get("block_index"),
                        "delta": message.get("delta"),
                    }
                )
            elif kind == "state":
                frame = {
                    "t": "chat_state",
                    "status": message.get("status"),
                    "turn_id": message.get("turn_id") or "",
                    "model": message.get("model") or "",
                    "permission_mode": message.get("permission_mode") or "default",
                    "claude_session_id": message.get("claude_session_id") or "",
                    "cost_usd": message.get("cost_usd"),
                    "usage": message.get("usage") or {},
                    "context_tokens": message.get("context_tokens"),
                    "capabilities": message.get("capabilities") or {},
                }
                # Keep the hello snapshot current so a later hub reconnect
                # (or a hub connection that appeared after this frame) still
                # learns the latest status.
                hello = self.chat_hello_payload
                if hello is not None:
                    for key in (
                        "status",
                        "model",
                        "permission_mode",
                        "claude_session_id",
                        "capabilities",
                    ):
                        value = frame.get(key)
                        if value not in (None, "", {}):
                            hello[key] = value
                self._send(frame)
            elif kind == "permission":
                permission_id = str(message.get("permission_id") or "")
                if permission_id:
                    with self.chat_pending_lock:
                        entry = dict(message)
                        entry["id"] = permission_id
                        self.chat_pending[permission_id] = entry
                self._send(
                    {
                        "t": "chat_permission_request",
                        "permission_id": permission_id,
                        "turn_id": message.get("turn_id") or "",
                        "request_id": message.get("request_id") or "",
                        "tool_name": message.get("tool_name") or "",
                        "input": message.get("input") or {},
                        "suggestions": message.get("suggestions") or [],
                        "expires_at": message.get("expires_at"),
                    }
                )
            elif kind == "permission_resolved":
                permission_id = str(message.get("permission_id") or "")
                with self.chat_pending_lock:
                    self.chat_pending.pop(permission_id, None)
                self._send(
                    {
                        "t": "chat_permission_resolved",
                        "permission_id": permission_id,
                        "status": message.get("status") or "denied",
                        "decision": message.get("decision") or {},
                        "resolved_by": message.get("resolved_by") or "runner",
                    }
                )
            elif kind == "mode":
                self._send(
                    {
                        "t": "chat_mode",
                        "mode": message.get("mode") or "",
                        "status": message.get("status") or "idle",
                        "message": message.get("message") or "",
                    }
                )
            elif kind == "exit":
                # A handoff exits the runner intentionally; forwarding
                # chat_exit would race the following chat_mode and mark the
                # session offline.
                if message.get("reason") != "handoff":
                    self._send(
                        {
                            "t": "chat_exit",
                            "code": message.get("code"),
                            "reason": message.get("reason") or "",
                            "claude_session_id": self.claude_session_id,
                        }
                    )
                return
            elif kind == "error":
                self._send(
                    {
                        "t": "chat_error",
                        "message": message.get("message") or "chat runner error",
                        "retryable": bool(message.get("retryable", True)),
                    }
                )
            elif kind == "sync_done":
                try:
                    self.chat_last_local_seq = max(
                        self.chat_last_local_seq, int(message.get("last_local_seq") or 0)
                    )
                except (TypeError, ValueError):
                    pass

    def _deny_chat_pending(self, message: str) -> None:
        with self.chat_pending_lock:
            items = list(self.chat_pending.keys())
            self.chat_pending.clear()
        decision = {"behavior": "deny", "message": message}
        for permission_id in items:
            self._send(
                {
                    "t": "chat_permission_resolved",
                    "permission_id": permission_id,
                    "status": "denied",
                    "decision": decision,
                    "resolved_by": "handoff",
                }
            )

    def _ensure_runner(self) -> bool:
        if os.path.exists(runner_path(self.session_id)):
            return True
        try:
            cfg = self._cfg()
            me = api_call(cfg, "GET", "/client/me", timeout=10)
            launch = read_json(chat_paths(self.session_id)["launch"], {}) or {}
            item = {
                "id": self.session_id,
                "name": self.name,
                "cwd": self.cwd,
                "tmux": self.tmux,
                "claude_session_id": (
                    self.claude_session_id or str(launch.get("claude_session_id") or "")
                ),
            }
            write_runner(
                item,
                cfg,
                me,
                list(launch.get("user_claude_args") or []),
                mode=self.mode,
            )
            return True
        except (ApiError, OSError) as exc:
            self.log(f"cannot rebuild the mode supervisor: {exc}")
            return False

    def _signal_pane_child(self, sig: int = signal.SIGTERM) -> int:
        """Signal the supervisor's current child (claude or __chat)."""
        try:
            panes = subprocess.run(
                ["tmux", "list-panes", "-t", self.tmux, "-F", "#{pane_pid}"],
                capture_output=True,
                text=True,
                timeout=5,
            )
            if panes.returncode != 0:
                return 0
            for token in panes.stdout.split():
                if not token.isdigit():
                    continue
                children = subprocess.run(
                    ["pgrep", "-P", token],
                    capture_output=True,
                    text=True,
                    timeout=5,
                )
                for child in children.stdout.split():
                    if not child.isdigit():
                        continue
                    try:
                        os.kill(int(child), sig)
                        return int(child)
                    except OSError:
                        continue
        except (OSError, subprocess.SubprocessError):
            pass
        return 0

    def _handle_handoff(self, to, force: bool) -> None:
        if to not in ("chat", "tui", "terminal"):
            self._send(
                {"t": "chat_error", "message": "mode must be chat or tui", "retryable": False}
            )
            return
        to = "tui" if to == "terminal" else to
        if not self.handoff_lock.acquire(blocking=False):
            self._send(
                {
                    "t": "chat_error",
                    "message": "a handoff is already in progress",
                    "retryable": True,
                }
            )
            return
        try:
            if to == self.mode:
                self._send(
                    {
                        "t": "chat_mode",
                        "mode": self.mode,
                        "status": "idle",
                        "message": "already in this mode",
                    }
                )
                return
            self._send(
                {
                    "t": "chat_mode",
                    "mode": "handoff",
                    "status": "handoff",
                    "message": f"switching to {to}",
                }
            )
            if to == "tui":
                # Flip the mode file and stop the chat runner; the supervisor
                # notices and starts the TUI.  Never respawn the pane: the
                # kill signal from respawn-pane raced and could take out the
                # freshly started process (and the session with it).
                self._chat_send({"t": "handoff", "to": "tui"})
                self._deny_chat_pending("session switched to terminal mode")
                write_mode(self.session_id, "tui")
                self._signal_pane_child()
                deadline = time.monotonic() + 3.0
                while (
                    not force
                    and self.chat_connected
                    and time.monotonic() < deadline
                    and not self.stop_event.is_set()
                ):
                    time.sleep(0.05)
                self.mode = "tui"
                self._send({"t": "chat_mode", "mode": "tui", "status": "idle", "message": ""})
            else:
                if not self._ensure_runner():
                    self._send(
                        {
                            "t": "chat_error",
                            "message": "mode supervisor is missing; restart the session",
                            "retryable": False,
                        }
                    )
                    return
                write_mode(self.session_id, "chat")
                # Stop the TUI child; the supervisor's prompt loop sees the
                # mode change and starts __chat without losing the tmux pane.
                self._signal_pane_child()
                self.mode = "chat"
                self._send(
                    {"t": "chat_mode", "mode": "chat", "status": "starting", "message": ""}
                )
        finally:
            self.handoff_lock.release()

    def _open_channel(self, message: dict) -> None:
        ch = int(message.get("ch", -1))
        if ch < 0:
            return
        if not tmux_has(self.tmux):
            self._send({"t": "error", "ch": ch, "message": "tmux session is gone"})
            self._send({"t": "exit", "ch": ch, "code": 1})
            return
        cols = max(2, min(int(message.get("cols", 120)), 500))
        rows = max(2, min(int(message.get("rows", 32)), 500))
        try:
            proc = spawn_pty(["tmux", "attach-session", "-t", self.tmux], cols, rows)
        except Exception as exc:  # noqa: BLE001
            self._send({"t": "error", "ch": ch, "message": f"cannot attach: {exc}"})
            self._send({"t": "exit", "ch": ch, "code": 1})
            return
        stop = threading.Event()
        with self.channels_lock:
            self.channels[ch] = (proc, stop)
        self._send({"t": "opened", "ch": ch})

        def reader() -> None:
            def on_data(data: bytes) -> None:
                self._send({"t": "out", "ch": ch, "data": base64.b64encode(data).decode("ascii")})

            pump_pty(proc, on_data, stop)
            stop.set()
            code = proc.proc.poll()
            proc.close()
            with self.channels_lock:
                self.channels.pop(ch, None)
            self._send({"t": "exit", "ch": ch, "code": code})

        threading.Thread(target=reader, name=f"pty-{ch}", daemon=True).start()

    def _close_channel(self, ch: int) -> None:
        with self.channels_lock:
            channel = self.channels.pop(ch, None)
        if channel:
            channel[1].set()
            channel[0].close()

    def _close_all_channels(self) -> None:
        with self.channels_lock:
            channels = list(self.channels.values())
            self.channels.clear()
        for proc, stop in channels:
            stop.set()
            proc.close()

    def _send_buffer(self, ch: int) -> None:
        """Return the newest tmux paste buffer for this host.

        tmux mouse selections go into tmux's buffer, not xterm's, so this is
        how the web UI can copy what the user selected in the terminal.
        """
        if ch < 0:
            return
        name = ""
        created = 0
        size = 0
        try:
            meta = subprocess.run(
                ["tmux", "list-buffers", "-F", "#{buffer_name}\t#{buffer_created}\t#{buffer_size}"],
                capture_output=True,
                text=True,
                timeout=5,
            )
            for line in meta.stdout.splitlines():
                parts = line.split("\t")
                if len(parts) < 3:
                    continue
                try:
                    c = int(float(parts[1] or 0))
                    s = int(parts[2] or 0)
                except ValueError:
                    c, s = 0, 0
                if not name or (c and c > created):
                    name, created, size = parts[0], c, s
        except Exception as exc:  # noqa: BLE001
            self._send({"t": "buffer", "ch": ch, "error": f"{type(exc).__name__}: {exc}"})
            return
        try:
            cmd = ["tmux", "show-buffer"] + (["-b", name] if name else [])
            show = subprocess.run(cmd, capture_output=True, timeout=5)
        except Exception as exc:  # noqa: BLE001
            self._send({"t": "buffer", "ch": ch, "error": f"{type(exc).__name__}: {exc}"})
            return
        if show.returncode != 0:
            err = (show.stderr or b"").decode("utf-8", "replace").strip() or "tmux buffer is empty"
            self._send({"t": "buffer", "ch": ch, "error": err[:300]})
            return
        data = show.stdout[: 1024 * 1024]
        self._send(
            {
                "t": "buffer",
                "ch": ch,
                "data": base64.b64encode(data).decode("ascii"),
                "created": created,
                "size": len(show.stdout),
                "name": name,
            }
        )

    def _send(self, obj: dict) -> None:
        with self.ws_lock:
            ws = self.ws
        if ws is None:
            return
        try:
            ws.send_json(obj)
        except WSClosed:
            pass
        except Exception as exc:  # noqa: BLE001
            if not self._send_warned:
                self._send_warned = True
                self.log(f"send failed: {type(exc).__name__}: {exc}")


def cmd_agent(args: argparse.Namespace) -> int:
    agent = Agent(args)
    signal.signal(signal.SIGTERM, lambda *_: agent.stop())
    signal.signal(signal.SIGINT, lambda *_: agent.stop())
    return agent.run()


