def cmd_msg(args: argparse.Namespace) -> int:
    cfg = ensure_config()
    text = " ".join(args.text).strip()
    if not text:
        print("opencloddie: message text is required", file=sys.stderr)
        return 2
    sender = args.session or session_from_env_or_local()
    payload: dict = {"to": args.target, "body": text}
    if sender:
        payload["session"] = sender
    if args.reply_to is not None:
        payload["reply_to"] = int(args.reply_to)
    try:
        result = api_call(cfg, "POST", "/client/mailbox", payload)
    except ApiError as exc:
        candidates = exc.extra.get("candidates") if isinstance(exc.extra, dict) else None
        if candidates:
            print("opencloddie: that session name is ambiguous:", file=sys.stderr)
            for candidate in candidates:
                print(
                    "  {name}@{host}  {id}  {cwd}".format(
                        name=candidate.get("name") or "?",
                        host=candidate.get("hostname") or "?",
                        id=candidate.get("id") or "?",
                        cwd=candidate.get("cwd") or "",
                    ),
                    file=sys.stderr,
                )
        raise
    if args.json:
        print(json.dumps(result, indent=2))
        return 0
    message = result.get("message") or {}
    target = result.get("target") or {}
    state = "online" if target.get("online") else "offline, queued"
    print(
        f"sent #{message.get('id')} to {target.get('name') or args.target} "
        f"({target.get('id') or '?'}, {state})"
    )
    return 0


def cmd_inbox(args: argparse.Namespace) -> int:
    cfg = ensure_config()
    session = args.session or session_from_env_or_local()
    if not session:
        print(
            "opencloddie: no session selected; run inside a session or pass --session",
            file=sys.stderr,
        )
        return 2
    query = urllib.parse.urlencode(
        {
            "session": session,
            "unread": "0" if args.all else "1",
            "limit": max(1, min(int(args.limit), 100)),
        }
    )
    data = api_call(cfg, "GET", f"/client/mailbox?{query}")
    messages = data.get("messages") or []
    if args.json:
        print(json.dumps(data, indent=2))
    elif not messages:
        print("mailbox empty")
    else:
        for message in messages:
            sender = message.get("from_name") or "unknown"
            sender_id = message.get("from_session_id") or ""
            suffix = f" ({sender_id})" if sender_id else ""
            print(
                f"--- #{message.get('id')} from {sender}{suffix} "
                f"· {message.get('created_at')} ---"
            )
            print(message.get("body") or "")
            print()
        if data.get("unread"):
            print(f"{data['unread']} unread remaining")
    if not args.peek and messages:
        ids = [int(message["id"]) for message in messages if message.get("id") is not None]
        if ids:
            try:
                api_call(
                    cfg,
                    "POST",
                    "/client/mailbox/read",
                    {"session": session, "ids": ids},
                    timeout=10,
                )
            except ApiError as exc:
                print(
                    f"opencloddie: could not mark messages read: {exc.message}",
                    file=sys.stderr,
                )
    return 0


def cmd_stop(args: argparse.Namespace) -> int:
    cfg = ensure_config()
    sessions = load_sessions()
    sid, item = find_local_session(sessions, args.target)
    targets = []
    if sid:
        targets.append(sid)
        tmux_kill(item.get("tmux", ""))
        stop_agent(item)
        sessions.pop(sid, None)
        save_sessions(sessions)
        print(f"stopped local session {item.get('name')} ({sid})")
    else:
        # Maybe the session lives on another machine and is only known remotely.
        data = api_call(cfg, "GET", "/client/sessions")
        for s in data.get("sessions", []):
            if s.get("id") == args.target or s.get("name") == args.target:
                targets.append(s["id"])
        if not targets:
            raise SystemExit(f"no session named {args.target!r} (local or remote)")
    for target in targets:
        try:
            api_call(cfg, "DELETE", f"/client/sessions/{target}")
            print(f"removed server session {target}")
        except ApiError as exc:
            if exc.status != 404:
                print(f"warning: could not remove {target}: {exc.message}", file=sys.stderr)
    return 0


