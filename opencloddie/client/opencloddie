            "another session. Compose a complete, self-contained message: the "
            "other session cannot see this conversation. Sending only queues "
            "mail; it does not interrupt or wake the other session. Do not "
            "send unless the user asked."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "to": {
                    "type": "string",
                    "description": "Target session name, name@hostname, or id.",
                },
                "message": {
