def _resolve_mode(args: argparse.Namespace) -> str:
    explicit = getattr(args, "mode", None)
    want_chat = bool(getattr(args, "chat", False))
    if explicit and want_chat and explicit != "chat":
        raise SystemExit("opencloddie: --chat conflicts with --mode tui")
    mode = explicit or ("chat" if want_chat else "tui")
    return mode if mode in ("chat", "tui") else "tui"


def cmd_run(args: argparse.Namespace) -> int:
    cfg = ensure_config()
    cwd = os.path.abspath(args.cwd or os.getcwd())
    name = (args.name or os.path.basename(cwd) or "session").strip()[:60]
    claude_args = list(args.claude_args)
    if claude_args and claude_args[0] == "--":
        claude_args = claude_args[1:]
    mode = _resolve_mode(args)
    _, item, me = start_local_session(
        cfg, name, cwd, claude_args, force_new=args.new, mode=mode
    )
    tmux_name = item["tmux"]
    if mode == "chat":
        # Chat sessions are driven from the web UI; never attach the terminal
        # to a headless stream-json process.
        print(f"session {item['name']!r} is running in chat mode")
        print(f"  web:    {web_session_url(cfg, me, item['id'])}")
        print(f"  attach: opencloddie attach {shlex.quote(item['name'])}")
        return 0
    if args.no_attach or not (sys.stdin.isatty() and sys.stdout.isatty()):
        print(f"session {item['name']!r} is running in tmux {tmux_name}")
        print(f"  attach: tmux attach -t {tmux_name}")
        print(f"  web:    {me.get('web_url') or cfg.get('web_url') or cfg['server']}")
        return 0
    os.environ.pop("TMUX", None)
    print(f"attaching to {item['name']} ({tmux_name}); detach with Ctrl-b d", file=sys.stderr)
    try:
        os.execvp("tmux", ["tmux", "attach-session", "-t", tmux_name])
    except OSError as exc:
        raise SystemExit(f"opencloddie: could not attach: {exc}") from exc
    return 0


def cmd_attach(args: argparse.Namespace) -> int:
    cfg = ensure_config()
    sessions = load_sessions()
    if not args.target:
        if len(sessions) == 1:
            target = next(iter(sessions))
        else:
            rows = [(sid, s) for sid, s in sessions.items() if tmux_has(s.get("tmux", ""))]
            if not rows:
                raise SystemExit("no local sessions; run `opencloddie` first")
            if len(rows) > 1:
                print("local sessions:")
                for sid, s in rows:
                    print(f"  {s['name']:24} {sid}  {s['tmux']}")
                raise SystemExit("specify a session name")
            target = rows[0][0]
    else:
        target = args.target
    sid, item = find_local_session(sessions, target)
    if not sid:
        raise SystemExit(f"no local session named {target!r}")
    if not tmux_has(item["tmux"]):
        raise SystemExit(f"tmux session {item['tmux']} is gone; run `opencloddie --name {item['name']}`")
    ensure_agent(cfg, item)
    if read_mode(sid, item.get("mode") or "tui") == "chat":
        try:
            me = api_call(cfg, "GET", "/client/me", timeout=10)
        except ApiError:
            me = {}
        print(f"chat session {item.get('name')!r} is driven from the web UI")
        print(f"  web: {web_session_url(cfg, me, sid)}")
        return 0
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print(f"tmux attach -t {item['tmux']}")
        return 0
    os.environ.pop("TMUX", None)
    try:
        os.execvp("tmux", ["tmux", "attach-session", "-t", item["tmux"]])
    except OSError as exc:
        raise SystemExit(f"opencloddie: could not attach: {exc}") from exc
    return 0


def cmd_ls(args: argparse.Namespace) -> int:
    cfg = ensure_config()
    data = api_call(cfg, "GET", "/client/sessions")
    sessions = data.get("sessions", [])
    if args.json:
        print(json.dumps(sessions, indent=2))
        return 0
    local = load_sessions()
    if not sessions:
        print("no sessions registered yet; run `opencloddie` on a machine with Claude Code")
        return 0
    print(f"{'NAME':24} {'ID':20} {'MODE':5} {'ONLINE':7} {'UNREAD':7} {'MODEL':26} {'CWD':32} 'HOST'")
    for s in sessions:
        online = "yes" if s.get("online") else "no"
        unread = int(s.get("unread") or 0)
        local_item = local.get(s.get("id")) or {}
        chat_info = s.get("chat") if isinstance(s.get("chat"), dict) else {}
        mode = local_item.get("mode") or chat_info.get("mode") or "tui"
        tag = " *local" if s.get("id") in local else ""
        print(
            f"{str(s.get('name',''))[:24]:24} {str(s.get('id','')):20} {str(mode)[:5]:5} {online:7} "
            f"{unread:7} "
            f"{str(s.get('model',''))[:26]:26} {str(s.get('cwd',''))[:32]:32} "
            f"{str(s.get('hostname',''))[:24]}{tag}"
        )
    print("\n* local session on this machine")
    return 0


def cmd_msg(args: argparse.Namespace) -> int:
    cfg = ensure_config()
    text = " ".join(args.text).strip()
    if not text:
        print("opencloddie: message text is required", file=sys.stderr)
        return 2
    sender = args.session or session_from_env_or_local()
    payload: dict = {"to": args.target, "body": text}
    if sender:
        payload["session"] = sender
    if args.reply_to is not None:
        payload["reply_to"] = int(args.reply_to)
    try:
        result = api_call(cfg, "POST", "/client/mailbox", payload)
    except ApiError as exc:
        candidates = exc.extra.get("candidates") if isinstance(exc.extra, dict) else None
        if candidates:
            print("opencloddie: that session name is ambiguous:", file=sys.stderr)
            for candidate in candidates:
                print(
                    "  {name}@{host}  {id}  {cwd}".format(
                        name=candidate.get("name") or "?",
                        host=candidate.get("hostname") or "?",
                        id=candidate.get("id") or "?",
                        cwd=candidate.get("cwd") or "",
                    ),
                    file=sys.stderr,
                )
        raise
    if args.json:
        print(json.dumps(result, indent=2))
        return 0
    message = result.get("message") or {}
    target = result.get("target") or {}
    state = "online" if target.get("online") else "offline, queued"
    print(
        f"sent #{message.get('id')} to {target.get('name') or args.target} "
        f"({target.get('id') or '?'}, {state})"
    )
    return 0


def cmd_inbox(args: argparse.Namespace) -> int:
    cfg = ensure_config()
    session = args.session or session_from_env_or_local()
    if not session:
        print(
            "opencloddie: no session selected; run inside a session or pass --session",
            file=sys.stderr,
        )
        return 2
    query = urllib.parse.urlencode(
        {
