# --------------------------------------------------------------------------
# WebSocket client (standalone; mirrors the server's protocol)
# --------------------------------------------------------------------------
GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
OP_CONT, OP_TEXT, OP_BINARY, OP_CLOSE, OP_PING, OP_PONG = 0, 1, 2, 8, 9, 10


class WSClosed(Exception):
    pass


class WSClient:
    """WebSocket client driven by a single thread.

    Python's SSLSocket is not safe for a blocking read and a write at the
    same time: under load the two threads corrupt the TLS record stream and
    the peer closes with a bad-record-mac alert.  That is what used to drop
    the agent whenever a busy terminal pushed output while the heartbeat or
    a keystroke was being sent.  All socket I/O now happens in the thread
    that calls recv(); other threads enqueue frames and wake it through a
    pipe.
    """

    MAX_OUTBOX = 8 * 1024 * 1024
    MAX_MESSAGE = 16 * 1024 * 1024

    def __init__(self, sock, rfile):
        self.sock = sock
        self.rfile = rfile  # used only during the HTTP upgrade
        self.lock = threading.Lock()
        self.closed = False
        self._outbox = collections.deque()
        self._outbox_bytes = 0
        self._inbuf = bytearray()
        self._messages = collections.deque()
        self._partial = []
        self._partial_opcode = None
        self._partial_bytes = 0
        self._socket_closed = False
        self._want_write = False
        self._close_deadline = float("inf")
        self._io_lock = threading.Lock()
        self._wake_r, self._wake_w = os.pipe()
        os.set_blocking(self._wake_r, False)
        os.set_blocking(self._wake_w, False)
        try:
            sock.setblocking(False)
        except OSError:
            pass

    @classmethod
    def connect(cls, url: str, headers: dict | None = None, timeout: float | None = 20.0):
        parts = urllib.parse.urlsplit(url)
        secure = parts.scheme in ("wss", "https")
        host = parts.hostname or ""
        port = parts.port or (443 if secure else 80)
        path = parts.path or "/"
        if parts.query:
            path += "?" + parts.query
        raw = socket.create_connection((host, port), timeout=timeout)
        if secure:
            raw = ssl.create_default_context().wrap_socket(raw, server_hostname=host)
        key = base64.b64encode(os.urandom(16)).decode("ascii")
        lines = [
            f"GET {path} HTTP/1.1",
            f"Host: {host}:{port}",
            "Upgrade: websocket",
            "Connection: Upgrade",
            f"Sec-WebSocket-Key: {key}",
            "Sec-WebSocket-Version: 13",
            f"User-Agent: {USER_AGENT}",
        ]
        for name, value in (headers or {}).items():
            lines.append(f"{name}: {value}")
        raw.sendall(("\r\n".join(lines) + "\r\n\r\n").encode("latin-1"))
        rfile = raw.makefile("rb")
        status = rfile.readline()
        if not status:
            raw.close()
            raise WSClosed("empty handshake response")
        if b" 101 " not in status:
            body = rfile.read(512).decode("utf-8", "replace")
            raw.close()
            raise WSClosed(f"handshake failed: {status.decode('latin-1').strip()} {body}")
        accept = None
        while True:
            line = rfile.readline()
            if line in (b"\r\n", b"\n", b""):
                break
            name, _, value = line.decode("latin-1").partition(":")
            if name.strip().lower() == "sec-websocket-accept":
                accept = value.strip()
        import hashlib

        expected = base64.b64encode(hashlib.sha1((key + GUID).encode()).digest()).decode()
        if accept != expected:
            raw.close()
            raise WSClosed("invalid Sec-WebSocket-Accept")
        return cls(raw, rfile)

    def send(self, opcode: int, payload: bytes) -> None:
        frame = _encode(opcode, payload, mask=True)
        with self.lock:
            if self.closed:
                raise WSClosed("closed")
            if opcode < OP_CLOSE and self._outbox_bytes + len(frame) > self.MAX_OUTBOX:
                # The peer is not draining; drop new data rather than grow
                # without bound (the agent's PTY pump would otherwise stall).
                return
            self._outbox.append(frame)
            self._outbox_bytes += len(frame)
        self._wake()

    def send_json(self, obj: dict) -> None:
        self.send(OP_TEXT, json.dumps(obj, separators=(",", ":")).encode("utf-8"))

    def recv(self):
        """Return the next complete message, doing all socket I/O here."""
        with self._io_lock:
            return self._recv_locked()

    def _recv_locked(self):
        while True:
            if self._messages:
                return self._messages.popleft()
            if self.closed:
                try:
                    self._flush()
                except WSClosed:
                    pass
                with self.lock:
                    drained = not self._outbox
                if drained or time.monotonic() >= self._close_deadline:
                    self._shutdown()
                    raise WSClosed("closed")
            wlist = [self.sock] if (self._outbox or self._want_write) else []
            try:
                readable, writable, _ = select.select([self.sock, self._wake_r], wlist, [], 1.0)
            except (OSError, ValueError) as exc:
                self._shutdown()
                raise WSClosed(f"select failed: {exc}") from exc
            if self._wake_r in readable:
                self._drain_wake()
            if self.sock in writable:
                try:
                    self._flush()
                except WSClosed:
                    self._shutdown()
                    raise
            if self.sock in readable:
                try:
                    self._read_available()
                except WSClosed:
                    self._shutdown()
                    raise

    def close(self) -> None:
        with self.lock:
            if self.closed:
                return
            self.closed = True
            self._close_deadline = time.monotonic() + 2.0
            frame = _encode(OP_CLOSE, struct.pack("!H", 1000), mask=True)
            self._outbox.append(frame)
            self._outbox_bytes += len(frame)
        self._wake()

    def wait_closed(self, timeout: float = 1.5) -> None:
        """Flush a queued close frame, then release the socket."""
        with self._io_lock:
            self._wait_closed_locked(timeout)

    def _wait_closed_locked(self, timeout: float) -> None:
        deadline = time.monotonic() + timeout
        while True:
            with self.lock:
                if self._socket_closed:
                    return
                drained = not self._outbox
            if not drained:
                try:
                    self._flush()
                except WSClosed:
                    break
                with self.lock:
                    drained = not self._outbox
            if drained or time.monotonic() >= deadline:
                break
            try:
                select.select([self.sock], [self.sock], [], 0.05)
            except (OSError, ValueError):
                break
        self._shutdown()

    # ------------------------------------------------------------- internals
    def _wake(self) -> None:
        try:
            os.write(self._wake_w, b"\0")
        except (BlockingIOError, OSError):
            pass

    def _drain_wake(self) -> None:
        try:
            while os.read(self._wake_r, 4096):
                pass
        except (BlockingIOError, OSError):
            pass

    def _flush(self) -> None:
        while True:
            with self.lock:
                if not self._outbox:
                    self._want_write = False
                    return
                chunk = self._outbox[0]
            try:
                written = self.sock.send(chunk)
            except (ssl.SSLWantWriteError, BlockingIOError):
                self._want_write = True
                return
            except ssl.SSLWantReadError:
                self._want_write = False
                return
            except (OSError, ValueError) as exc:
                raise WSClosed(f"socket send failed: {exc}") from exc
            if written <= 0:
                raise WSClosed("socket closed during send")
            with self.lock:
                if written >= len(chunk):
                    self._outbox.popleft()
                    self._outbox_bytes -= len(chunk)
                else:
                    self._outbox[0] = chunk[written:]
                    self._outbox_bytes -= written
            self._want_write = False

    def _read_available(self) -> None:
        while True:
            try:
                data = self.sock.recv(65536)
            except (ssl.SSLWantReadError, BlockingIOError):
                break
            except ssl.SSLWantWriteError:
                self._want_write = True
                break
            except (OSError, ValueError) as exc:
                raise WSClosed(f"socket read failed: {exc}") from exc
            if not data:
                raise WSClosed("unexpected EOF")
            self._inbuf.extend(data)
        self._parse()

    def _parse(self) -> None:
        while True:
            if len(self._inbuf) < 2:
                return
            b1, b2 = self._inbuf[0], self._inbuf[1]
            fin = bool(b1 & 0x80)
            opcode = b1 & 0x0F
            masked = bool(b2 & 0x80)
            n = b2 & 0x7F
            offset = 2
            if n == 126:
                if len(self._inbuf) < 4:
                    return
                n = struct.unpack("!H", self._inbuf[2:4])[0]
                offset = 4
            elif n == 127:
                if len(self._inbuf) < 10:
                    return
                n = struct.unpack("!Q", self._inbuf[2:10])[0]
                offset = 10
            if n > self.MAX_MESSAGE:
                raise WSClosed("frame too large")
            key = b""
            if masked:
                if len(self._inbuf) < offset + 4:
                    return
                key = bytes(self._inbuf[offset : offset + 4])
                offset += 4
            if len(self._inbuf) < offset + n:
                return
            payload = bytes(self._inbuf[offset : offset + n])
            del self._inbuf[: offset + n]
            if masked:
                payload = _mask_payload(payload, key)
            if opcode == OP_CLOSE:
                raise WSClosed("server closed")
            if opcode == OP_PING:
                self.send(OP_PONG, payload)
                continue
            if opcode == OP_PONG:
                continue
            if opcode == OP_CONT:
                if self._partial_opcode is None:
                    raise WSClosed("bad continuation")
            else:
                if self._partial_opcode is not None:
                    raise WSClosed("interleaved message")
                self._partial_opcode = opcode
            self._partial.append(payload)
            self._partial_bytes += len(payload)
            if self._partial_bytes > self.MAX_MESSAGE:
                raise WSClosed("message too large")
            if fin:
                self._messages.append((self._partial_opcode, b"".join(self._partial)))
                self._partial = []
                self._partial_opcode = None
                self._partial_bytes = 0

    def _shutdown(self) -> None:
        with self.lock:
            if self._socket_closed:
                return
            self._socket_closed = True
            self.closed = True
            self._outbox.clear()
            self._outbox_bytes = 0
        try:
            self.sock.close()
        except OSError:
            pass
        for fd in (self._wake_r, self._wake_w):
            try:
                os.close(fd)
            except OSError:
                pass


def _mask_payload(payload: bytes, key: bytes) -> bytes:
    n = len(payload)
    if not n:
        return payload
    stream = (key * ((n + 3) // 4))[:n]
    return (int.from_bytes(payload, "big") ^ int.from_bytes(stream, "big")).to_bytes(n, "big")


def _encode(opcode: int, payload: bytes, *, mask: bool) -> bytes:
    n = len(payload)
    first = 0x80 | opcode
    second = 0x80 if mask else 0
    if n < 126:
        header = bytes([first, second | n])
    elif n < 65536:
        header = bytes([first, second | 126]) + struct.pack("!H", n)
    else:
        header = bytes([first, second | 127]) + struct.pack("!Q", n)
    if not mask:
        return header + payload
    key = os.urandom(4)
    return header + key + _mask_payload(payload, key)


# --------------------------------------------------------------------------
# PTY helpers (standalone)
# --------------------------------------------------------------------------
MAX_PENDING_INPUT = 256 * 1024


class Pty:
    def __init__(self, master: int, proc: subprocess.Popen):
        self.master = master
        self.proc = proc
        self.closed = False
        try:
            os.set_blocking(self.master, False)
        except OSError:
            pass
        self._pending = bytearray()
        self._pending_lock = threading.Lock()
        self._flusher: threading.Thread | None = None

    def resize(self, cols: int, rows: int) -> None:
        try:
            fcntl.ioctl(
                self.master,
                termios.TIOCSWINSZ,
                struct.pack("HHHH", max(2, min(int(rows), 1000)), max(2, min(int(cols), 1000)), 0, 0),
            )
        except OSError:
            pass

    def write(self, data: bytes) -> None:
        """Queue input for the pane without blocking the WebSocket reader.

        A synchronous write blocks once the pane's input buffer is full (for
        example during a fast wheel scroll while the TUI is redrawing).  That
        stalls the agent's frame reader, which in turn blocks the server's
        writes and eventually drops the agent connection.  Buffer a bounded
        amount and let a small writer thread drain it instead.
        """
        with self._pending_lock:
            if self.closed:
                return
            if len(self._pending) + len(data) > MAX_PENDING_INPUT:
                # Overwhelmed input (usually repeat scroll events) is dropped
                # rather than growing memory without bound.
                return
            self._pending += data
            if self._flusher is None:
                self._flusher = threading.Thread(
                    target=self._flush_loop,
                    name=f"pty-write-{self.master}",
                    daemon=True,
                )
                self._flusher.start()

    def _flush_loop(self) -> None:
        while True:
            with self._pending_lock:
                if self.closed or not self._pending:
                    self._pending.clear()
                    self._flusher = None
                    return
                chunk = bytes(self._pending)
            try:
                written = os.write(self.master, chunk)
            except (BlockingIOError, InterruptedError):
                try:
                    select.select([], [self.master], [], 0.2)
                except (OSError, ValueError):
                    with self._pending_lock:
                        self._pending.clear()
                        self._flusher = None
                    return
                continue
            except OSError:
                with self._pending_lock:
                    self._pending.clear()
                    self._flusher = None
                return
            if written <= 0:
                with self._pending_lock:
                    self._pending.clear()
                    self._flusher = None
                return
            with self._pending_lock:
                del self._pending[:written]

    def close(self) -> None:
        with self._pending_lock:
            self.closed = True
            self._pending.clear()
        try:
            if self.proc.poll() is None:
                self.proc.terminate()
                try:
                    self.proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    self.proc.kill()
        finally:
            try:
                os.close(self.master)
            except OSError:
                pass


def spawn_pty(argv: list[str], cols: int, rows: int) -> Pty:
    master, slave = pty.openpty()
    try:
        fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
        env = dict(os.environ)
        env["TERM"] = env.get("TERM") or "xterm-256color"
        env.pop("TMUX", None)
        proc = subprocess.Popen(
            argv,
            stdin=slave,
            stdout=slave,
            stderr=slave,
            env=env,
            start_new_session=True,
            preexec_fn=_make_controlling_tty,
            close_fds=True,
        )
    except Exception:
        os.close(master)
        os.close(slave)
        raise
    os.close(slave)
    return Pty(master, proc)


def pump_pty(proc: Pty, on_data, stop: threading.Event) -> None:
    while not stop.is_set():
        try:
            ready, _, _ = select.select([proc.master], [], [], 0.2)
        except (OSError, ValueError):
            break
        if not ready:
            if proc.proc.poll() is not None:
                break
            continue
        try:
            data = os.read(proc.master, 65536)
        except (BlockingIOError, InterruptedError):
            continue
        except OSError:
            break
        if not data:
            break
        try:
            on_data(data)
        except Exception:  # noqa: BLE001
            break


TIOCSCTTY = getattr(termios, "TIOCSCTTY", None)


def _make_controlling_tty() -> None:
    """Make the PTY slave the child's controlling terminal.

    Without TIOCSCTTY the kernel does not deliver SIGWINCH to `tmux attach`,
    so browser resizes change the PTY size but tmux never resizes its client.
    Runs in the forked child before exec.
    """
    if TIOCSCTTY is None:
        return
    try:
        fcntl.ioctl(0, TIOCSCTTY, 0)
    except OSError:
        pass


