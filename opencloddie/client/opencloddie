# --------------------------------------------------------------------------
class Agent:
    def __init__(self, args: argparse.Namespace):
        self.config_file = args.config
        self.session_id = args.session_id
        self.tmux = args.tmux
        self.name = args.name
        self.cwd = args.cwd
        self.agent_id = args.agent_id or ("a-" + secrets.token_hex(8))
        self.stop_event = threading.Event()
        self.ws: WSClient | None = None
        self.ws_lock = threading.Lock()
        self.channels: dict[int, tuple[Pty, threading.Event]] = {}
        self.channels_lock = threading.Lock()
        self.features: dict[str, bool] = {}
        self._send_warned = False

    def log(self, message: str) -> None:
        stamp = time.strftime("%H:%M:%S")
        print(f"[{stamp}] {message}", file=sys.stderr, flush=True)

    def _cfg(self) -> dict:
        cfg = read_json(self.config_file, {}) or {}
        if not cfg.get("server") or not cfg.get("api_key"):
            raise SystemExit("agent: config disappeared or is incomplete")
        return cfg

    def run(self) -> int:
        self.features["mouse"] = tmux_enable_mouse(self.tmux)
        threading.Thread(target=self._monitor, name="monitor", daemon=True).start()
        backoff = 1.0
        while not self.stop_event.is_set():
            if not tmux_has(self.tmux):
                self.log(f"tmux session {self.tmux} is gone; exiting")
                self.stop()
                break
            started = time.monotonic()
            try:
                self._session()
                backoff = 1.0
            except WSClosed as exc:
                if self.stop_event.is_set():
                    break
                text = str(exc)
                self.log(f"websocket closed: {text}")
                if "401" in text or "403" in text:
                    self.log("authentication failed; retrying in 60s (check `opencloddie login`)")
                    if self.stop_event.wait(60):
                        break
                    continue
            except Exception as exc:  # noqa: BLE001
                if self.stop_event.is_set():
                    break
                self.log(f"connection error: {type(exc).__name__}: {exc}")
            # A connection that stayed up for a while was healthy; start its
            # retry delay over instead of letting backoff ratchet to 30s for
            # the rest of the process's lifetime.
            if time.monotonic() - started >= 30:
                backoff = 1.0
            if self.stop_event.is_set():
                break
            self.stop_event.wait(backoff)
            backoff = min(30.0, backoff * 2)
        self._close_all_channels()
        self.log("agent stopped")
        return 0

    def stop(self) -> None:
        self.stop_event.set()
        with self.ws_lock:
            ws = self.ws
            self.ws = None
        if ws:
            try:
                ws.close()
            except Exception:  # noqa: BLE001
                pass
        self._close_all_channels()

    def _monitor(self) -> None:
        misses = 0
        while not self.stop_event.wait(10):
            if tmux_has(self.tmux):
                misses = 0
            else:
                misses += 1
                if misses >= 3:
                    self.log("tmux session disappeared; stopping agent")
                    self.stop()
                    return

    def _session(self) -> None:
        cfg = self._cfg()
        server = norm_server(cfg["server"])
        url = server + "/agent/ws?agent_id=" + urllib.parse.quote(self.agent_id)
        self.log(f"connecting to {server}")
        ws = WSClient.connect(url, headers={"Authorization": f"Bearer {cfg['api_key']}"}, timeout=20)
        self._send_warned = False
        # The I/O loop is non-blocking and woken by writes; liveness comes
        # from the 20s heartbeat, not a socket read timeout.
        with self.ws_lock:
            self.ws = ws
        ws.send_json(
            {
                "t": "hello",
                "agent_id": self.agent_id,
                "version": VERSION,
                "hostname": socket.gethostname(),
                "platform": sys.platform,
                "features": self.features,
                "session": {
                    "id": self.session_id,
                    "name": self.name,
                    "cwd": self.cwd,
                },
            }
        )
        welcome_seen = False
        heartbeat = threading.Thread(target=self._heartbeat, args=(ws,), name="heartbeat", daemon=True)
        heartbeat.start()
        try:
            while not self.stop_event.is_set():
                opcode, payload = ws.recv()
                if opcode != OP_TEXT:
                    continue
                try:
                    message = json.loads(payload.decode("utf-8"))
                except (UnicodeDecodeError, json.JSONDecodeError):
                    continue
                kind = message.get("t")
                if kind == "welcome":
                    welcome_seen = True
                    self.log(f"registered session {self.session_id} (model {message.get('model')})")
                elif kind == "open":
                    self._open_channel(message)
                elif kind == "in":
                    channel = self.channels.get(int(message.get("ch", -1)))
                    if channel:
                        try:
                            channel[0].write(base64.b64decode(message.get("data", "")))
                        except Exception:  # noqa: BLE001
                            pass
                elif kind == "resize":
                    channel = self.channels.get(int(message.get("ch", -1)))
                    if channel:
                        channel[0].resize(int(message.get("cols", 80)), int(message.get("rows", 24)))
                elif kind == "get_buffer":
                    self._send_buffer(int(message.get("ch", -1)))
                elif kind == "close":
                    self._close_channel(int(message.get("ch", -1)))
                elif kind == "kill":
                    self.log("server requested kill; stopping session")
                    tmux_kill(self.tmux)
                    self.stop()
                    return
                elif kind == "pong":
                    pass
        finally:
            with self.ws_lock:
                if self.ws is ws:
                    self.ws = None
            self._close_all_channels()
            try:
                ws.close()
                ws.wait_closed()
            except Exception:  # noqa: BLE001
                pass
            if not welcome_seen:
                self.log("connection closed before registration")

    def _heartbeat(self, ws: WSClient) -> None:
        while not self.stop_event.wait(20):
            try:
                ws.send_json({"t": "ping", "ts": time.time()})
            except WSClosed:
                return
            except Exception as exc:  # noqa: BLE001
                self.log(f"heartbeat stopped: {type(exc).__name__}: {exc}")
                return

    def _open_channel(self, message: dict) -> None:
        ch = int(message.get("ch", -1))
        if ch < 0:
            return
        if not tmux_has(self.tmux):
            self._send({"t": "error", "ch": ch, "message": "tmux session is gone"})
            self._send({"t": "exit", "ch": ch, "code": 1})
            return
        cols = max(2, min(int(message.get("cols", 120)), 500))
        rows = max(2, min(int(message.get("rows", 32)), 500))
        try:
            proc = spawn_pty(["tmux", "attach-session", "-t", self.tmux], cols, rows)
        except Exception as exc:  # noqa: BLE001
            self._send({"t": "error", "ch": ch, "message": f"cannot attach: {exc}"})
            self._send({"t": "exit", "ch": ch, "code": 1})
            return
        stop = threading.Event()
        with self.channels_lock:
            self.channels[ch] = (proc, stop)
        self._send({"t": "opened", "ch": ch})

        def reader() -> None:
            def on_data(data: bytes) -> None:
                self._send({"t": "out", "ch": ch, "data": base64.b64encode(data).decode("ascii")})

            pump_pty(proc, on_data, stop)
            stop.set()
            code = proc.proc.poll()
            proc.close()
            with self.channels_lock:
                self.channels.pop(ch, None)
            self._send({"t": "exit", "ch": ch, "code": code})

        threading.Thread(target=reader, name=f"pty-{ch}", daemon=True).start()

    def _close_channel(self, ch: int) -> None:
        with self.channels_lock:
            channel = self.channels.pop(ch, None)
        if channel:
            channel[1].set()
            channel[0].close()

    def _close_all_channels(self) -> None:
        with self.channels_lock:
            channels = list(self.channels.values())
            self.channels.clear()
        for proc, stop in channels:
            stop.set()
            proc.close()

    def _send_buffer(self, ch: int) -> None:
        """Return the newest tmux paste buffer for this host.

        tmux mouse selections go into tmux's buffer, not xterm's, so this is
        how the web UI can copy what the user selected in the terminal.
        """
        if ch < 0:
            return
        name = ""
        created = 0
        size = 0
        try:
            meta = subprocess.run(
                ["tmux", "list-buffers", "-F", "#{buffer_name}\t#{buffer_created}\t#{buffer_size}"],
                capture_output=True,
                text=True,
                timeout=5,
            )
            for line in meta.stdout.splitlines():
                parts = line.split("\t")
                if len(parts) < 3:
                    continue
                try:
                    c = int(float(parts[1] or 0))
                    s = int(parts[2] or 0)
                except ValueError:
                    c, s = 0, 0
                if not name or (c and c > created):
                    name, created, size = parts[0], c, s
        except Exception as exc:  # noqa: BLE001
            self._send({"t": "buffer", "ch": ch, "error": f"{type(exc).__name__}: {exc}"})
            return
        try:
            cmd = ["tmux", "show-buffer"] + (["-b", name] if name else [])
            show = subprocess.run(cmd, capture_output=True, timeout=5)
        except Exception as exc:  # noqa: BLE001
            self._send({"t": "buffer", "ch": ch, "error": f"{type(exc).__name__}: {exc}"})
            return
        if show.returncode != 0:
            err = (show.stderr or b"").decode("utf-8", "replace").strip() or "tmux buffer is empty"
            self._send({"t": "buffer", "ch": ch, "error": err[:300]})
            return
        data = show.stdout[: 1024 * 1024]
        self._send(
            {
                "t": "buffer",
                "ch": ch,
                "data": base64.b64encode(data).decode("ascii"),
                "created": created,
                "size": len(show.stdout),
                "name": name,
            }
        )

    def _send(self, obj: dict) -> None:
        with self.ws_lock:
            ws = self.ws
        if ws is None:
            return
        try:
            ws.send_json(obj)
        except WSClosed:
            pass
        except Exception as exc:  # noqa: BLE001
            if not self._send_warned:
                self._send_warned = True
                self.log(f"send failed: {type(exc).__name__}: {exc}")


def cmd_agent(args: argparse.Namespace) -> int:
    agent = Agent(args)
    signal.signal(signal.SIGTERM, lambda *_: agent.stop())
    signal.signal(signal.SIGINT, lambda *_: agent.stop())
    return agent.run()


