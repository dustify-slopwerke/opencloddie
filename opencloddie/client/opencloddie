VERSION = "0.5.0"
APP = "opencloddie"
USER_AGENT = f"{APP}-cli/{VERSION}"
DEFAULT_TIMEOUT = 30


# --------------------------------------------------------------------------
# config
# --------------------------------------------------------------------------
def config_dir() -> str:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, APP)


def state_dir() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    path = os.path.join(base, APP)
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def cache_dir() -> str:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    path = os.path.join(base, APP)
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def config_path() -> str:
    return os.environ.get("OPENCLODDIE_CONFIG") or os.path.join(config_dir(), "config.json")


def sessions_path() -> str:
    override = os.environ.get("OPENCLODDIE_CONFIG")
    if override:
        # Keep local bookkeeping next to an explicitly selected config.
        return os.path.join(os.path.dirname(os.path.abspath(override)), "sessions.json")
    return os.path.join(config_dir(), "sessions.json")


def read_json(path: str, default):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        return default


def write_json(path: str, data, mode: int = 0o600) -> None:
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def load_config() -> dict:
    return read_json(config_path(), {}) or {}


def save_config(cfg: dict) -> None:
    write_json(config_path(), cfg)


def norm_server(value: str) -> str:
    value = (value or "").strip().rstrip("/")
    if not value:
        return ""
    if not re.match(r"^https?://", value, re.I):
        host = value.split("/", 1)[0].split(":", 1)[0]
        scheme = "http" if host in ("localhost", "127.0.0.1", "::1") else "https"
        value = f"{scheme}://{value}"
    for suffix in ("/v1/messages", "/v1", "/gateway"):
        if value.endswith(suffix):
            value = value[: -len(suffix)].rstrip("/")
    return value


def redact_key(key: str) -> str:
    if not key:
        return ""
    return "*" * max(0, len(key) - 4) + key[-4:]


# --------------------------------------------------------------------------
# HTTP API
# --------------------------------------------------------------------------
class ApiError(Exception):
    def __init__(self, status: int, message: str, extra: dict | None = None):
        super().__init__(message)
        self.status = status
        self.message = message
        self.extra = extra or {}


def api_call(cfg: dict, method: str, path: str, body=None, timeout: float = DEFAULT_TIMEOUT) -> dict:
    server = norm_server(cfg.get("server", ""))
    if not server:
        raise ApiError(0, "no server configured; run `opencloddie login`")
    url = server + path
    data = None
    headers = {
        "Authorization": f"Bearer {cfg.get('api_key', '')}",
        "Accept": "application/json",
        "User-Agent": USER_AGENT,
    }
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = response.read()
            try:
                return json.loads(raw.decode("utf-8")) if raw else {}
            except json.JSONDecodeError as exc:
                raise ApiError(response.status, "server returned invalid JSON") from exc
    except urllib.error.HTTPError as exc:
        raw = exc.read(8192)
        message = raw.decode("utf-8", "replace")
        extra: dict = {}
        try:
            parsed = json.loads(message)
            error = parsed.get("error") if isinstance(parsed, dict) else None
            if isinstance(error, dict):
                message = error.get("message") or parsed.get("message") or message
                extra = {
                    key: value
                    for key, value in error.items()
                    if key not in ("message", "type")
                }
            elif isinstance(parsed, dict):
                message = parsed.get("message") or message
        except json.JSONDecodeError:
            pass
        raise ApiError(exc.code, str(message)[:500], extra) from exc
    except urllib.error.URLError as exc:
        raise ApiError(0, f"cannot reach {server}: {exc.reason}") from exc
    except TimeoutError as exc:
        raise ApiError(0, f"timed out talking to {server}") from exc


def login_flow(server: str, api_key: str, *, quiet: bool = False) -> dict:
    server = norm_server(server)
    api_key = (api_key or "").strip()
    if not server or not api_key:
        raise ApiError(0, "server URL and API key are required")
    probe = {"server": server, "api_key": api_key}
    me = api_call(probe, "GET", "/client/me")
    cfg = {
        "server": server,
        "api_key": api_key,
        "web_url": me.get("web_url") or server,
        "username": (me.get("user") or {}).get("username", ""),
        "model": me.get("model", ""),
        "claude_bin": load_config().get("claude_bin") or "",
    }
    save_config(cfg)
    if not quiet:
        print(f"connected to {server}")
        print(f"  user:   {cfg['username']}")
        print(f"  model:  {cfg['model']}")
        print(f"  web:    {cfg['web_url']}")
        if load_sessions():
            print(
                "\n  note: running sessions keep their previous API key until restarted.\n"
                "        Use `opencloddie stop NAME` then start it again to apply the new key."
            )
        if not me.get("opencode_key_set"):
            print()
            print("  ! No OpenCode API key is configured for your account.")
            print(f"    Add one at {cfg['web_url']} settings, or Claude requests will fail.")
    return cfg


def ensure_config(*, prompt: bool = True) -> dict:
    cfg = load_config()
    env_server = os.environ.get("OPENCLODDIE_SERVER")
    env_key = os.environ.get("OPENCLODDIE_API_KEY")
    if env_server or env_key:
        cfg = dict(cfg)
        if env_server:
            cfg["server"] = norm_server(env_server)
        if env_key:
            cfg["api_key"] = env_key
    if cfg.get("server") and cfg.get("api_key"):
        return cfg
    if os.environ.get("OPENCLODDIE_SERVER") and os.environ.get("OPENCLODDIE_API_KEY"):
        return cfg
    if not prompt or not sys.stdin.isatty():
        raise SystemExit(
            "opencloddie is not configured.\n"
            "Run: opencloddie login --server https://your.host --api-key ocd_sk_...\n"
            "or set OPENCLODDIE_SERVER and OPENCLODDIE_API_KEY."
        )
    print("First run: connect opencloddie to your server.")
    server = input("Server URL (e.g. https://cloddie.example.com): ").strip()
    key = getpass.getpass("API key (ocd_sk_...): ").strip()
    return login_flow(server, key)


# --------------------------------------------------------------------------
# local session bookkeeping
# --------------------------------------------------------------------------
def load_sessions() -> dict:
    return (read_json(sessions_path(), {}) or {}).get("sessions", {})


def session_from_env_or_local() -> str | None:
    """Best-effort identity for `msg`/`inbox`.

    The runner exports OPENCLODDIE_SESSION_ID for new sessions.  Older tmux
    sessions predate that, so fall back to the longest local cwd prefix, then
    to the only local session when there is exactly one.
    """
    value = (os.environ.get("OPENCLODDIE_SESSION_ID") or "").strip()
    if value:
        return value
    local = load_sessions()
    if not isinstance(local, dict):
        return None
    cwd = os.path.realpath(os.getcwd())
    best: tuple[int, str] | None = None
    ids: set[str] = set()
    for item in local.values():
        if not isinstance(item, dict):
            continue
        session_id = str(item.get("id") or "")
        if not session_id:
            continue
        ids.add(session_id)
        root = os.path.realpath(str(item.get("cwd") or ""))
        if root and (cwd == root or cwd.startswith(root.rstrip(os.sep) + os.sep)):
            if best is None or len(root) > best[0]:
                best = (len(root), session_id)
    if best is not None:
        return best[1]
    if len(ids) == 1:
        return next(iter(ids))
    return None


def save_sessions(sessions: dict) -> None:
    write_json(sessions_path(), {"sessions": sessions})


def slug(value: str, fallback: str = "session") -> str:
    text = re.sub(r"[^a-z0-9._-]+", "-", (value or "").lower()).strip("-._")
    return (text[:32] or fallback).strip("-._") or fallback


def tmux_has(name: str) -> bool:
    if not name or not shutil.which("tmux"):
        return False
    return subprocess.run(
        ["tmux", "has-session", "-t", f"={name}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0


def tmux_kill(name: str) -> bool:
    if not name:
        return False
    return subprocess.run(
        ["tmux", "kill-session", "-t", f"={name}"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0


def tmux_enable_mouse(name: str) -> bool:
    """Let the web terminal's wheel/touch pan scroll tmux copy-mode.

    The option is set on this session only, so the user's other tmux sessions
    keep their own mouse setting.  Older tmux versions reject a per-session
    mouse option; drag-to-scroll then stays unavailable rather than changing
    the global setting behind the user's back.
    """
    if not name or not shutil.which("tmux"):
        return False
    try:
        result = subprocess.run(
            ["tmux", "set-option", "-t", name, "mouse", "on"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
        return result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def pid_is_agent(pid: int, session_id: str) -> bool:
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            cmdline = fh.read().replace(b"\x00", b" ").decode("utf-8", "replace")
        return "__agent" in cmdline and session_id in cmdline
    except OSError:
        return pid_alive(pid)


def find_local_session(sessions: dict, target: str) -> tuple[str, dict] | tuple[None, None]:
    if target in sessions:
        return target, sessions[target]
    matches = [(sid, s) for sid, s in sessions.items() if s.get("name") == target]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        raise SystemExit(f"multiple local sessions named {target!r}; use the session id")
    return None, None


def find_or_create_mapping(sessions: dict, name: str, cwd: str, *, force_new: bool) -> tuple[str, dict]:
    if not force_new:
        for sid, item in sessions.items():
            if item.get("name") == name and item.get("cwd") == cwd:
                return sid, item
    session_id = "s_" + secrets.token_hex(8)
    tmux_name = f"ocd-{slug(name)}-{secrets.token_hex(4)}"
    item = {
        "id": session_id,
        "name": name,
        "cwd": cwd,
        "tmux": tmux_name,
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    sessions[session_id] = item
    save_sessions(sessions)
    return session_id, item


# --------------------------------------------------------------------------
# session environment / runner
# --------------------------------------------------------------------------
def find_claude_bin(cfg: dict) -> str:
    configured = (cfg.get("claude_bin") or "").strip()
    if configured:
        return configured
    found = shutil.which("claude")
    if not found:
        raise SystemExit(
            'opencloddie: "claude" not found on PATH. Install Claude Code first '
            "(https://claude.com/claude-code)."
        )
    return found


def gateway_env(cfg: dict, me: dict) -> dict[str, str]:
    model = me.get("model") or cfg.get("model") or "deepseek-v4.1-flash"
    env = {
        "ANTHROPIC_BASE_URL": norm_server(cfg["server"]),
        "ANTHROPIC_AUTH_TOKEN": cfg["api_key"],
        "ANTHROPIC_DEFAULT_OPUS_MODEL": model,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": model,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": model,
    }
    context = me.get("context_tokens")
    if context:
        env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = str(context)
    return env


def write_mcp_config(item: dict, cfg: dict, me: dict) -> str | None:
    """Write the per-session MCP server config Claude Code loads.

    The JSON contains no secret: the shim reads the client config file, which
    is already 0600.  It lives next to the runner in the cache directory.
    """
    if me.get("messages_enabled") is False:
        return None
    script = os.path.realpath(__file__)
    cfg_file = os.path.abspath(config_path())
    payload = {
        "mcpServers": {
            "opencloddie": {
                "type": "stdio",
                "command": sys.executable or "python3",
                "args": [
                    script,
                    "__mcp",
                    "--config",
                    cfg_file,
                    "--session-id",
                    item["id"],
                    "--name",
                    item.get("name") or "",
                ],
                "env": {
                    "OPENCLODDIE_CONFIG": cfg_file,
                    "OPENCLODDIE_SESSION_ID": item["id"],
                },
            }
        }
    }
    path = os.path.join(cache_dir(), f"mcp-{item['id']}.json")
    write_json(path, payload, mode=0o600)
    return path


def write_runner(item: dict, cfg: dict, me: dict, claude_args: list[str]) -> str:
    model = me.get("model") or cfg.get("model") or "deepseek-v4.1-flash"
    claude_bin = find_claude_bin(cfg)
    env = gateway_env(cfg, me)
    env["OPENCLODDIE_CONFIG"] = os.path.abspath(config_path())
    env["OPENCLODDIE_SESSION_ID"] = item["id"]
    mcp_path = write_mcp_config(item, cfg, me)
    cmd = [claude_bin, "--model", model]
    if mcp_path and not any(
        arg == "--mcp-config" or arg.startswith("--mcp-config=") for arg in claude_args
    ):
        cmd += ["--mcp-config", mcp_path]
    elif mcp_path:
        print(
            "opencloddie: warning: --mcp-config already supplied; not adding the mailbox MCP server",
            file=sys.stderr,
        )
    cmd += list(claude_args)
    lines = [
        "#!/usr/bin/env bash",
        "set -u",
        f"cd -- {shlex.quote(item['cwd'])}",
    ]
    for key in (
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_MODEL",
        "ANTHROPIC_SMALL_FAST_MODEL",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS",
        "CLAUDE_CODE_USE_BEDROCK",
        "CLAUDE_CODE_USE_VERTEX",
        "CLAUDE_CODE_USE_FOUNDRY",
    ):
        lines.append(f"unset {key}")
    for key, value in env.items():
        lines.append(f"export {key}={shlex.quote(value)}")
    lines += [
        "while :; do",
        f"  {shlex.join(cmd)}",
        "  printf '\\n[claude exited - press Enter to restart, Ctrl-b d to detach]\\n'",
        "  read -r _ || break",
        "done",
        "",
    ]
    path = os.path.join(cache_dir(), f"runner-{item['id']}.sh")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines))
    os.chmod(path, 0o700)
    return path


def start_local_session(cfg: dict, name: str, cwd: str, claude_args: list[str], *, force_new: bool) -> tuple[str, dict]:
    if not shutil.which("tmux"):
        raise SystemExit("opencloddie: tmux is required. Install it (e.g. `apt install tmux`).")
    if not os.path.isdir(cwd):
        raise SystemExit(f"opencloddie: working directory does not exist: {cwd}")
    me = api_call(cfg, "GET", "/client/me")
    sessions = load_sessions()
    session_id, item = find_or_create_mapping(sessions, name, cwd, force_new=force_new)
    item["name"] = name
    item["cwd"] = cwd
    item["model"] = me.get("model", "")
    fingerprint = hashlib.sha256(
        f"{cfg.get('api_key','')}|{item['model']}|{me.get('context_tokens')}".encode()
    ).hexdigest()[:12]
    if tmux_has(item["tmux"]) and item.get("fingerprint") and item["fingerprint"] != fingerprint:
        print(
            "opencloddie: warning: this session was started with a different API key/model.\n"
            "  The running Claude process keeps its old environment; restart with\n"
            f"  `opencloddie stop {shlex.quote(item['name'])}` and start it again to apply.",
            file=sys.stderr,
        )
    item["fingerprint"] = fingerprint
    save_sessions(sessions)

    if not tmux_has(item["tmux"]):
        runner = write_runner(item, cfg, me, claude_args)
        result = subprocess.run(
            ["tmux", "new-session", "-d", "-s", item["tmux"], "-c", cwd, "--", "bash", runner],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            raise SystemExit(
                "opencloddie: could not create tmux session: "
                + (result.stderr.strip() or f"exit {result.returncode}")
            )
    tmux_enable_mouse(item["tmux"])
    ensure_agent(cfg, item)
    if not me.get("opencode_key_set"):
        print(
            f"opencloddie: warning: no OpenCode key configured for {me.get('user', {}).get('username', 'this user')}.\n"
            f"  Add one at {me.get('web_url') or cfg.get('web_url') or cfg['server']} before Claude can answer.",
            file=sys.stderr,
        )
    return session_id, item


def ensure_agent(cfg: dict, item: dict, *, wait: bool = True) -> bool:
    pidfile = os.path.join(state_dir(), f"agent-{item['id']}.pid")
    logfile = os.path.join(state_dir(), f"agent-{item['id']}.log")
    try:
        with open(pidfile, "r", encoding="utf-8") as fh:
            pid = int(fh.read().strip() or 0)
    except (OSError, ValueError):
        pid = 0
    if pid and pid_is_agent(pid, item["id"]):
        return True
    try:
        if os.path.getsize(logfile) > 5 * 1024 * 1024:
            with open(logfile, "wb") as fh:
                fh.truncate(0)
    except OSError:
        pass
    script = os.path.realpath(__file__)
    env = dict(os.environ)
    env.pop("TMUX", None)
    cmd = [
        sys.executable,
        script,
        "__agent",
        "--config",
        config_path(),
        "--session-id",
        item["id"],
        "--tmux",
        item["tmux"],
        "--name",
        item["name"],
        "--cwd",
        item["cwd"],
    ]
    log_handle = open(logfile, "ab")
    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            start_new_session=True,
            close_fds=True,
            env=env,
        )
    finally:
        log_handle.close()
    with open(pidfile, "w", encoding="utf-8") as fh:
        fh.write(str(proc.pid))
    item["agent_pid"] = proc.pid
    item["log"] = logfile
    if wait:
        _wait_online(cfg, item["id"], logfile, timeout=10)
    return True


def _wait_online(cfg: dict, session_id: str, logfile: str, timeout: float) -> None:
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            data = api_call(cfg, "GET", "/client/sessions", timeout=5)
            for session in data.get("sessions", []):
                if session.get("id") == session_id and session.get("online"):
                    return
        except ApiError:
            pass
        time.sleep(0.5)
    print("opencloddie: session is running locally, but the web agent has not registered yet.", file=sys.stderr)
    print(f"  agent log: {logfile}", file=sys.stderr)
    try:
        with open(logfile, "r", encoding="utf-8", errors="replace") as fh:
            tail = fh.read()[-1200:]
        if tail.strip():
            print("  " + tail.strip().replace("\n", "\n  "), file=sys.stderr)
    except OSError:
        pass


def stop_agent(item: dict) -> None:
    pidfile = os.path.join(state_dir(), f"agent-{item['id']}.pid")
    pid = 0
    try:
        with open(pidfile, "r", encoding="utf-8") as fh:
            pid = int(fh.read().strip() or 0)
    except (OSError, ValueError):
        pass
    if pid and pid_is_agent(pid, item["id"]):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        deadline = time.time() + 3
        while time.time() < deadline and pid_alive(pid):
            time.sleep(0.1)
        if pid_alive(pid):
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    try:
        os.unlink(pidfile)
    except OSError:
        pass


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------
def cmd_run(args: argparse.Namespace) -> int:
    cfg = ensure_config()
    cwd = os.path.abspath(args.cwd or os.getcwd())
    name = (args.name or os.path.basename(cwd) or "session").strip()[:60]
    claude_args = list(args.claude_args)
    if claude_args and claude_args[0] == "--":
        claude_args = claude_args[1:]
    _, item = start_local_session(cfg, name, cwd, claude_args, force_new=args.new)
    tmux_name = item["tmux"]
    if args.no_attach or not (sys.stdin.isatty() and sys.stdout.isatty()):
        print(f"session {item['name']!r} is running in tmux {tmux_name}")
        print(f"  attach: tmux attach -t {tmux_name}")
        print(f"  web:    {cfg.get('web_url') or cfg['server']}")
        return 0
    os.environ.pop("TMUX", None)
    print(f"attaching to {item['name']} ({tmux_name}); detach with Ctrl-b d", file=sys.stderr)
    try:
        os.execvp("tmux", ["tmux", "attach-session", "-t", tmux_name])
    except OSError as exc:
        raise SystemExit(f"opencloddie: could not attach: {exc}") from exc
    return 0


def cmd_attach(args: argparse.Namespace) -> int:
    cfg = ensure_config()
    sessions = load_sessions()
    if not args.target:
        if len(sessions) == 1:
            target = next(iter(sessions))
        else:
            rows = [(sid, s) for sid, s in sessions.items() if tmux_has(s.get("tmux", ""))]
            if not rows:
                raise SystemExit("no local sessions; run `opencloddie` first")
            if len(rows) > 1:
                print("local sessions:")
                for sid, s in rows:
                    print(f"  {s['name']:24} {sid}  {s['tmux']}")
                raise SystemExit("specify a session name")
            target = rows[0][0]
    else:
        target = args.target
    sid, item = find_local_session(sessions, target)
    if not sid:
        raise SystemExit(f"no local session named {target!r}")
    if not tmux_has(item["tmux"]):
        raise SystemExit(f"tmux session {item['tmux']} is gone; run `opencloddie --name {item['name']}`")
    ensure_agent(cfg, item)
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print(f"tmux attach -t {item['tmux']}")
        return 0
    os.environ.pop("TMUX", None)
    try:
        os.execvp("tmux", ["tmux", "attach-session", "-t", item["tmux"]])
    except OSError as exc:
        raise SystemExit(f"opencloddie: could not attach: {exc}") from exc
    return 0


