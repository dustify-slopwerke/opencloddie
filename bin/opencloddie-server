#!/usr/bin/env python3
"""Launcher for the opencloddie server (works from a git checkout)."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from opencloddie.server import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
