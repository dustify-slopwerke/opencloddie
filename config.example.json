{
  "server": {
    "web_host": "0.0.0.0",
    "web_port": 8787,
    "api_host": "0.0.0.0",
    "api_port": 8788,
    "public_web_url": "https://cloddie.example.com",
    "public_api_url": "https://cloddie.example.com",
    "log_level": "info",
    "state_dir": "/data",
    "tls_cert": "",
    "tls_key": "",
    "behind_proxy": true
  },
  "web": {
    "user_header": "Remote-User",
    "groups_header": "Remote-Groups",
    "email_header": "Remote-Email",
    "name_header": "Remote-Name",
    "proxy_secret": "",
    "proxy_secret_header": "X-OpenCloddie-Proxy-Secret",
    "dev_user": "",
    "auth_portal_url": "https://auth.example.com",
    "title": "opencloddie"
  },
  "gateway": {
    "upstream": "https://opencode.ai/inference/go/anthropic",
    "auth_style": "bearer",
    "connect_timeout": 30,
    "read_timeout": 900,
    "max_body_bytes": 33554432,
    "fallback_model": "",
    "default_model": "deepseek-v4.1-flash",
    "models": [
      {
        "id": "deepseek-v4.1-flash",
        "label": "DeepSeek V4.1 Flash",
        "context_tokens": 1000000,
        "note": "Fast, cheap, long context."
      },
      {
        "id": "qwen3.8-flash",
        "label": "Qwen3.8 Flash",
        "context_tokens": null,
        "note": "Strong coding model."
      },
      {
        "id": "glm-5.3-flash",
        "label": "GLM-5.3 Flash",
        "context_tokens": 1000000,
        "note": "Long context."
      },
      {
        "id": "claude-haiku-5-5",
        "label": "Claude Haiku 5.5",
        "context_tokens": 1000000,
        "note": "Small, fast."
      },
      {
        "id": "minimax-m3",
        "label": "MiniMax M3",
        "context_tokens": null,
        "note": "Alternative coding model."
      }
    ],
    "allow_client_model_override": false,
    "rate_limit_per_minute": 120,
    "user_agent": "opencloddie-gateway/0.1"
  },
  "secrets": {
    "master": "REPLACE_ME -- generated by `opencloddie-server init`"
  },
  "metrics": {
    "sample_seconds": 60,
    "retention_days": 7,
    "admin_groups": ["god"]
  },
  "database": {
    "path": "/data/opencloddie.db"
  }
}
